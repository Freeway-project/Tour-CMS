---
import { MAX_SLIDES } from '../lib/photos';
import type { Photo as PhotoType } from '../lib/types';
import Icon, { type IconName } from './Icon.astro';
import Photo from './Photo.astro';

/**
 * Full-bleed hero that sits under the transparent header.
 *
 * - `slideshow` (default from `HERO_SLIDESHOW` in src/lib/ui-settings.ts):
 *   the photos crossfade, 6 s each with a 1.5 s fade. Pure CSS: every slide
 *   runs the same keyframes with a staggered `animation-delay`. No JS.
 *   Off, or one photo: static. No photo: the solid evergreen panel.
 * - `prefers-reduced-motion: reduce`: first photo only, nothing moves.
 * - Only the first photo loads eagerly with `fetchpriority="high"`.
 * - Height: 570–680px on mobile, 650–760px on desktop, tied to the viewport.
 */
interface Props {
  photos: PhotoType[];
  slideshow?: boolean;
  label?: string | null;
  heading: string;
  lead?: string | null;
  facts: { text: string; icon?: IconName }[];
  price?: string | null;
  priceUnit?: string | null;
  cta?: { href: string; label: string } | null;
  /** The page has a fixed bottom bar below `lg`: keep the hero text clear of it. */
  bottomBar?: boolean;
}

const { photos, slideshow = true, label, heading, lead, facts, price, priceUnit, cta, bottomBar = false } = Astro.props;

const SLIDE_SECONDS = 6;
const FADE_SECONDS = 1.5;
const slides = photos.slice(0, slideshow ? MAX_SLIDES : 1);
const count = slides.length;
const animated = count > 1;
const delay = (index: number) => `animation-delay: ${index * SLIDE_SECONDS - FADE_SECONDS}s`;
---

<section class:list={['hero relative isolate -mt-18 overflow-hidden bg-brand text-white', `hero-count-${count}`]}>
  {count > 0 ? (
    <div class="absolute inset-0 -z-10">
      {slides.map((photo, index) => (
        <div class="hero-slide absolute inset-0" style={animated ? delay(index) : undefined}>
          <Photo
            photo={photo}
            sizes="100vw"
            widths={[640, 960, 1280, 1920]}
            priority={index === 0}
            class="h-full w-full object-cover"
          />
        </div>
      ))}
      {/* Scrims: header legibility at the top, a deep fade behind the text (bottom on mobile, left on desktop). */}
      <div class="absolute inset-x-0 top-0 h-40 bg-linear-to-b from-brand-deep/70 to-transparent"></div>
      <div class="absolute inset-0 bg-linear-to-t from-brand-deep via-brand-deep/80 via-55% to-brand-deep/45 lg:bg-linear-to-r lg:from-brand-deep/90 lg:via-brand-deep/55 lg:via-50% lg:to-brand-deep/0"></div>
      <div class="absolute inset-x-0 bottom-0 hidden h-1/3 bg-linear-to-t from-brand-deep/60 to-transparent lg:block"></div>
    </div>
  ) : (
    <div class="absolute inset-0 -z-10 bg-linear-to-br from-brand to-brand-deep" aria-hidden="true"></div>
  )}

  <div
    class:list={[
      'container-site flex min-h-[clamp(570px,100svh,680px)] flex-col justify-end pt-28 lg:min-h-[clamp(650px,100svh,760px)] lg:justify-center lg:pt-32',
      bottomBar ? 'pb-28 lg:pb-20' : 'pb-14 lg:pb-20',
    ]}
  >
    <div class="max-w-2xl">
      {label ? (
        <p class="flex items-center gap-3 text-xs font-semibold tracking-[0.2em] text-white/90 uppercase">
          <span class="h-px w-8 bg-accent" aria-hidden="true"></span>{label}
        </p>
      ) : null}
      <h1 class="heading-hero mt-4 text-white">{heading}</h1>
      {lead ? <p class="mt-4 line-clamp-3 text-base text-white/85 text-pretty sm:line-clamp-none lg:mt-5 lg:text-lg">{lead}</p> : null}

      {price ? (
        <p class="mt-5 text-white/85 lg:mt-6">
          From <strong class="font-display text-2xl font-bold text-white lg:text-[1.75rem]">{price}</strong>
          {priceUnit ? <span> {priceUnit}</span> : null}
        </p>
      ) : null}

      {cta ? (
        <a
          href={cta.href}
          class="group mt-6 inline-flex items-center gap-2.5 rounded-btn bg-white px-6 py-3.5 text-base font-semibold text-brand shadow-lift transition duration-200 hover:-translate-y-0.5 hover:bg-mist focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-white motion-reduce:transition-none motion-reduce:hover:translate-y-0 lg:mt-7 lg:px-7 lg:py-4"
        >
          {cta.label}
          <Icon name="arrow" class="h-5 w-5 transition-transform duration-200 group-hover:translate-x-0.5 motion-reduce:transition-none" />
        </a>
      ) : null}

      {facts.length > 0 ? (
        <ul class="mt-6 flex flex-wrap gap-x-5 gap-y-2 text-sm text-white/85 lg:mt-8">
          {facts.map((fact) => (
            <li class="inline-flex items-center gap-2">
              {fact.icon ? <Icon name={fact.icon} class="h-4 w-4 text-accent" /> : null}
              {fact.text}
            </li>
          ))}
        </ul>
      ) : null}
    </div>
  </div>

  {count > 0 ? (
    <div
      class:list={[
        'pointer-events-none absolute right-5 flex max-w-[55%] flex-col items-end gap-2 sm:right-8',
        bottomBar ? 'bottom-24 lg:bottom-8' : 'bottom-5 lg:bottom-8',
      ]}
      aria-hidden="true"
    >
      <div class="hero-captions hidden text-right text-xs text-white/75 lg:grid">
        {slides.map((photo, index) => (
          <p class="hero-caption col-start-1 row-start-1 truncate" style={animated ? delay(index) : undefined}>{photo.alt}</p>
        ))}
      </div>
      {animated ? (
        <ol class="hero-dots flex gap-1.5">
          {slides.map((_, index) => (
            <li class="relative h-0.5 w-7 overflow-hidden rounded-pill bg-white/30">
              <span class="hero-dot absolute inset-0 bg-accent" style={delay(index)}></span>
            </li>
          ))}
        </ol>
      ) : null}
    </div>
  ) : null}
</section>

<style>
  /* Without animation (one photo, old browsers, reduced motion) the first slide shows. */
  .hero-slide,
  .hero-caption,
  .hero-dot {
    opacity: 0;
    animation-timing-function: ease-in-out;
    animation-iteration-count: infinite;
    animation-fill-mode: both;
  }
  .hero-slide:first-child,
  .hero-caption:first-child,
  li:first-child > .hero-dot {
    opacity: 1;
  }

  /* Cycle = 6 s × photos: fade in 1.5 s, hold, fade out while the next fades in. */
  .hero-count-2 :is(.hero-slide, .hero-caption, .hero-dot) { animation-duration: 12s; animation-name: hero-fade-2; }
  .hero-count-3 :is(.hero-slide, .hero-caption, .hero-dot) { animation-duration: 18s; animation-name: hero-fade-3; }
  .hero-count-4 :is(.hero-slide, .hero-caption, .hero-dot) { animation-duration: 24s; animation-name: hero-fade-4; }
  .hero-count-5 :is(.hero-slide, .hero-caption, .hero-dot) { animation-duration: 30s; animation-name: hero-fade-5; }
  .hero-count-6 :is(.hero-slide, .hero-caption, .hero-dot) { animation-duration: 36s; animation-name: hero-fade-6; }

  @keyframes hero-fade-2 { 0% { opacity: 0; } 12.5% { opacity: 1; } 50% { opacity: 1; } 62.5% { opacity: 0; } 100% { opacity: 0; } }
  @keyframes hero-fade-3 { 0% { opacity: 0; } 8.333% { opacity: 1; } 33.333% { opacity: 1; } 41.667% { opacity: 0; } 100% { opacity: 0; } }
  @keyframes hero-fade-4 { 0% { opacity: 0; } 6.25% { opacity: 1; } 25% { opacity: 1; } 31.25% { opacity: 0; } 100% { opacity: 0; } }
  @keyframes hero-fade-5 { 0% { opacity: 0; } 5% { opacity: 1; } 20% { opacity: 1; } 25% { opacity: 0; } 100% { opacity: 0; } }
  @keyframes hero-fade-6 { 0% { opacity: 0; } 4.167% { opacity: 1; } 16.667% { opacity: 1; } 20.833% { opacity: 0; } 100% { opacity: 0; } }

  @media (prefers-reduced-motion: reduce) {
    .hero-slide,
    .hero-caption,
    .hero-dot {
      animation: none !important;
    }
    .hero-slide:not(:first-child),
    .hero-caption:not(:first-child),
    .hero-dots {
      display: none;
    }
  }
</style>
