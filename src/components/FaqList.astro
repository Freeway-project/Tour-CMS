---
import { renderMarkdown } from '../lib/markdown';
import type { Faq } from '../lib/types';

interface Props {
  faqs: Faq[];
  heading?: string;
  id?: string;
}

const { faqs, heading = 'Frequently asked questions', id = 'faq-heading' } = Astro.props;
---

{faqs.length > 0 ? (
  <section class="mt-12" aria-labelledby={id}>
    <h2 id={id} class="text-2xl font-bold tracking-tight text-ink">
      {heading}
    </h2>
    <div class="mt-4 space-y-2">
      {faqs.map((faq) => (
        <details class="rounded-xl border border-ink/10 bg-white p-4">
          <summary class="cursor-pointer font-medium text-ink focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-brand">
            {faq.question}
          </summary>
          <div class="mt-2 space-y-3 text-sm text-ink/80" set:html={renderMarkdown(faq.answer)} />
        </details>
      ))}
    </div>
  </section>
) : null}
