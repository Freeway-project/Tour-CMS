---
import { todayInToronto } from '../../lib/datetime';
import { formatCad } from '../../lib/format';
import { quote } from '../../lib/pricing';
import type { Tour } from '../../lib/types';

interface Props {
  tour: Tour;
}

const { tour } = Astro.props;

const vehicles = tour.packages.filter(
  (pkg) => pkg.isActive && pkg.pricingMode === 'per_group' && pkg.maxPax !== null,
);
const firstVehicle = vehicles[0];
const initialGroupSize = 2;
const initialQuote = firstVehicle
  ? (() => {
      try {
        return quote({ pkg: firstVehicle, adults: initialGroupSize });
      } catch {
        return quote({ pkg: firstVehicle, adults: 1 });
      }
    })()
  : null;

const vehicleData = { packages: vehicles };
const vehicleJson = JSON.stringify(vehicleData).replace(/</g, '\\u003c');

const fieldClass =
  'mt-1 block w-full rounded-lg border border-ink/20 bg-white px-3 py-2 text-base text-ink focus-visible:border-brand';
const labelClass = 'block text-sm font-medium text-ink';
const legendClass = 'text-base font-semibold text-ink';
---

<section
  id="book"
  class="scroll-mt-24 rounded-2xl border border-ink/10 bg-white p-5 shadow-raised sm:p-7"
>
  <h2 class="text-2xl font-bold tracking-tight text-ink">Request this private tour</h2>
  <p class="mt-1 text-sm text-ink/70">
    Tell us the vehicle, date and group size. We will reply by email to confirm the details — no
    payment is taken now.
  </p>

  {vehicles.length === 0 ? (
    <p class="mt-6 rounded-lg bg-bg p-4 text-sm text-ink/80">
      This private tour is not available right now. Please call us and we will help.
    </p>
  ) : (
    <>
      <script type="application/json" id="inquiry-data" set:html={vehicleJson} />
      <form id="inquiry-form" method="POST" action="/booking/inquire" class="mt-6 space-y-8">
        <input type="hidden" name="tourSlug" value={tour.slug} />
        <fieldset>
          <legend class={legendClass}>Vehicle</legend>
          <div class="mt-3 grid gap-3">
            {vehicles.map((pkg, index) => (
              <label class="flex cursor-pointer gap-3 rounded-xl border border-ink/15 p-4 transition-colors hover:border-brand has-[:checked]:border-brand has-[:checked]:bg-brand/5">
                <input
                  type="radio"
                  name="packageId"
                  value={pkg.id}
                  checked={index === 0}
                  required
                  class="mt-1 size-4 accent-brand"
                />
                <span class="min-w-0">
                  <span class="block font-semibold text-ink">{pkg.name}</span>
                  <span class="mt-1 block text-sm text-ink/80">
                    {formatCad(pkg.priceAdultCents)} · up to {pkg.maxPax} people
                  </span>
                  <span class="mt-1 block text-xs text-ink/70">Plus HST</span>
                </span>
              </label>
            ))}
          </div>
        </fieldset>

        <div class="grid gap-4 sm:grid-cols-2">
          <div>
            <label for="inquiry-date" class={labelClass}>
              Preferred date
            </label>
            <input
              id="inquiry-date"
              name="preferredDate"
              type="date"
              min={todayInToronto()}
              required
              class={fieldClass}
            />
          </div>
          <div>
            <label for="inquiry-group-size" class={labelClass}>
              Group size
            </label>
            <input
              id="inquiry-group-size"
              name="groupSize"
              type="number"
              inputmode="numeric"
              min="1"
              max={firstVehicle?.maxPax ?? 1}
              step="1"
              value={initialGroupSize}
              required
              class={fieldClass}
            />
            <p id="inquiry-group-hint" class="mt-1 text-xs text-ink/70">
              Up to {firstVehicle?.maxPax ?? 1} people in this vehicle.
            </p>
          </div>
        </div>

        <fieldset>
          <legend class={legendClass}>Your details</legend>
          <div class="mt-3 grid gap-4 sm:grid-cols-2">
            <div class="sm:col-span-2">
              <label for="inquiry-name" class={labelClass}>
                Full name
              </label>
              <input
                id="inquiry-name"
                name="customerName"
                type="text"
                autocomplete="name"
                minlength="2"
                maxlength="80"
                required
                class={fieldClass}
              />
            </div>
            <div>
              <label for="inquiry-email" class={labelClass}>
                Email
              </label>
              <input
                id="inquiry-email"
                name="customerEmail"
                type="email"
                autocomplete="email"
                maxlength="254"
                required
                class={fieldClass}
              />
            </div>
            <div>
              <label for="inquiry-phone" class={labelClass}>
                Phone
              </label>
              <input
                id="inquiry-phone"
                name="customerPhone"
                type="tel"
                autocomplete="tel"
                minlength="7"
                maxlength="20"
                required
                class={fieldClass}
              />
            </div>
            <div class="sm:col-span-2">
              <label for="inquiry-message" class={labelClass}>
                Message <span class="font-normal text-ink/70">(optional)</span>
              </label>
              <textarea
                id="inquiry-message"
                name="message"
                rows="4"
                maxlength="1000"
                placeholder="Anything we should plan for? Pickup address, children, accessibility…"
                class={fieldClass}
              ></textarea>
            </div>
          </div>
        </fieldset>

        <div class="hidden" aria-hidden="true">
          <label for="inquiry-website">Website</label>
          <input
            id="inquiry-website"
            name="honeypot"
            type="text"
            tabindex="-1"
            autocomplete="off"
          />
        </div>

        <div class="rounded-xl bg-bg p-4 sm:p-5">
          <h3 class="text-base font-semibold text-ink">Your price</h3>
          <div id="inquiry-summary" class="mt-3" aria-live="polite" aria-atomic="true">
            {initialQuote ? (
              <dl class="space-y-2 text-sm">
                {initialQuote.lines.map((line) => (
                  <div class="flex items-baseline justify-between gap-4">
                    <dt class="text-ink/80">
                      {line.label} × {line.quantity}
                    </dt>
                    <dd class="tabular-nums text-ink">{formatCad(line.totalCents)}</dd>
                  </div>
                ))}
                <div class="flex items-baseline justify-between gap-4 border-t border-ink/10 pt-2">
                  <dt class="text-ink/80">Subtotal</dt>
                  <dd class="tabular-nums text-ink">{formatCad(initialQuote.subtotalCents)}</dd>
                </div>
                <div class="flex items-baseline justify-between gap-4">
                  <dt class="text-ink/80">HST (13%)</dt>
                  <dd class="tabular-nums text-ink">{formatCad(initialQuote.taxCents)}</dd>
                </div>
                <div class="flex items-baseline justify-between gap-4 text-base font-semibold">
                  <dt>Total</dt>
                  <dd class="tabular-nums">{formatCad(initialQuote.totalCents)}</dd>
                </div>
                <p class="pt-1 text-xs text-ink/70">Price shown includes HST.</p>
              </dl>
            ) : (
              <p class="text-sm text-ink/70">Choose a vehicle to see the price.</p>
            )}
          </div>
        </div>

        <div class="space-y-3">
          <button
            id="inquiry-submit"
            type="submit"
            class="w-full rounded-pill bg-brand px-6 py-3 text-base font-semibold text-bg shadow-raised transition-colors hover:bg-ink focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-brand disabled:cursor-not-allowed disabled:opacity-60"
          >
            Send inquiry
          </button>
          <p id="inquiry-blocked" class="text-sm text-ink/70" aria-live="polite"></p>
          <p
            id="inquiry-error"
            class="hidden rounded-lg border border-red-300 bg-red-50 p-3 text-sm text-red-800"
            aria-live="polite"
            aria-atomic="true"
          ></p>
        </div>
      </form>
    </>
  )}
</section>

<script>
  import { actions, isInputError, type ActionError } from 'astro:actions';

  import { messageForCode, readErrorCode } from '../../lib/booking-errors';
  import { formatCad } from '../../lib/format';
  import { quote } from '../../lib/pricing';
  import type { Package } from '../../lib/types';

  interface InquiryData {
    packages: Package[];
  }

  function isRecord(value: unknown): value is Record<string, unknown> {
    return typeof value === 'object' && value !== null;
  }

  function readInquiryData(): InquiryData | null {
    const element = document.getElementById('inquiry-data');
    if (!element || !element.textContent) return null;

    try {
      const parsed: unknown = JSON.parse(element.textContent);
      if (!isRecord(parsed) || !Array.isArray(parsed.packages)) return null;
      return parsed as unknown as InquiryData;
    } catch {
      return null;
    }
  }

  function describeError(error: ActionError): string {
    if (isInputError(error)) {
      for (const messages of Object.values(error.fields)) {
        const first = messages?.[0];
        if (first) return first;
      }
    }
    return error.message || 'Something went wrong. Please try again or call us.';
  }

  function init(form: HTMLFormElement, data: InquiryData): void {
    const submitElement = form.querySelector<HTMLButtonElement>('#inquiry-submit');
    const blockedElement = document.getElementById('inquiry-blocked');
    const errorBoxElement = document.getElementById('inquiry-error');
    const summaryElement = document.getElementById('inquiry-summary');
    const groupSizeElement = form.querySelector<HTMLInputElement>('input[name="groupSize"]');
    const groupHint = document.getElementById('inquiry-group-hint');

    if (
      !submitElement ||
      !blockedElement ||
      !errorBoxElement ||
      !summaryElement ||
      !groupSizeElement
    ) {
      return;
    }

    const submit = submitElement;
    const blocked = blockedElement;
    const errorBox = errorBoxElement;
    const summary = summaryElement;
    const groupSize = groupSizeElement;

    let redirecting = false;

    function selectedPackage(): Package | null {
      const checked = form.querySelector<HTMLInputElement>('input[name="packageId"]:checked');
      if (checked) return data.packages.find((pkg) => pkg.id === checked.value) ?? null;
      return data.packages[0] ?? null;
    }

    function groupCount(): number {
      const parsed = Number.parseInt(groupSize?.value ?? '1', 10);
      if (!Number.isFinite(parsed)) return 1;
      return Math.max(parsed, 1);
    }

    function addSummaryRow(
      list: HTMLDListElement,
      label: string,
      value: string,
      strong = false,
    ): void {
      const row = document.createElement('div');
      row.className = strong
        ? 'flex items-baseline justify-between gap-4 border-t border-ink/10 pt-2 text-base font-semibold'
        : 'flex items-baseline justify-between gap-4';

      const term = document.createElement('dt');
      if (!strong) term.className = 'text-ink/80';
      term.textContent = label;

      const description = document.createElement('dd');
      description.className = strong ? 'tabular-nums' : 'tabular-nums text-ink';
      description.textContent = value;

      row.append(term, description);
      list.append(row);
    }

    function renderSummary(): ReturnType<typeof quote> | null {
      const pkg = selectedPackage();
      summary.replaceChildren();

      if (!pkg) {
        const message = document.createElement('p');
        message.className = 'text-sm text-ink/70';
        message.textContent = 'Choose a vehicle to see the price.';
        summary.append(message);
        return null;
      }

      let result: ReturnType<typeof quote>;
      try {
        result = quote({ pkg, adults: groupCount() });
      } catch {
        const message = document.createElement('p');
        message.className = 'text-sm text-ink/70';
        message.textContent = 'This group is too big for that vehicle. Choose a bigger one.';
        summary.append(message);
        return null;
      }

      const list = document.createElement('dl');
      list.className = 'space-y-2 text-sm';

      for (const line of result.lines) {
        addSummaryRow(list, `${line.label} × ${line.quantity}`, formatCad(line.totalCents));
      }
      addSummaryRow(list, 'Subtotal', formatCad(result.subtotalCents));
      addSummaryRow(list, 'HST (13%)', formatCad(result.taxCents));
      addSummaryRow(list, 'Total', formatCad(result.totalCents), true);

      const note = document.createElement('p');
      note.className = 'pt-1 text-xs text-ink/70';
      note.textContent = 'Price shown includes HST.';
      list.append(note);

      summary.append(list);
      return result;
    }

    function update(): void {
      const pkg = selectedPackage();
      const maxPax = pkg?.maxPax ?? 1;
      const group = groupCount();

      groupSize.max = String(maxPax);
      if (groupHint) groupHint.textContent = `Up to ${maxPax} people in this vehicle.`;

      const result = renderSummary();
      let reason = '';

      if (!pkg) reason = 'Choose a vehicle to continue.';
      else if (group > maxPax) reason = `That vehicle seats up to ${maxPax} people.`;
      else if (!result)
        reason = 'We could not calculate that price. Please adjust your group size.';

      submit.disabled = redirecting || reason !== '';
      blocked.textContent = reason;
    }

    function showError(message: string): void {
      if (!message) {
        errorBox.textContent = '';
        errorBox.classList.add('hidden');
        return;
      }
      errorBox.textContent = message;
      errorBox.classList.remove('hidden');
    }

    form.addEventListener('change', update);
    form.addEventListener('input', (event) => {
      if (event.target === groupSize) update();
    });

    form.addEventListener('submit', async (event) => {
      event.preventDefault();
      if (submit.disabled || redirecting) return;

      showError('');
      redirecting = true;
      const originalLabel = submit.textContent;
      submit.textContent = 'Sending…';
      update();

      try {
        const result = await actions.createInquiry(new FormData(form));

        if (result.error) {
          showError(describeError(result.error));
        } else {
          window.location.assign('/booking/inquiry-sent');
          return;
        }
      } catch {
        showError('Something went wrong. Please check your connection and try again.');
      }

      redirecting = false;
      submit.textContent = originalLabel ?? 'Send inquiry';
      update();
    });

    update();
  }

  // A submit that bypassed this script comes back with `?error=<code>`: show
  // the same friendly text the action would have shown.
  function showQueryError(): void {
    const errorBox = document.getElementById('inquiry-error');
    const code = readErrorCode(window.location.search);
    if (!errorBox || !code) return;

    errorBox.textContent = messageForCode(code);
    errorBox.classList.remove('hidden');
  }

  const data = readInquiryData();
  const form = document.querySelector<HTMLFormElement>('#inquiry-form');
  if (data && form) init(form, data);
  showQueryError();
</script>
