---
import { formatCad } from '../../lib/format';
import { quote } from '../../lib/pricing';
import type { Tour } from '../../lib/types';

interface Props {
  tour: Tour;
}

const { tour } = Astro.props;

const packages = tour.packages.filter((pkg) => pkg.isActive && pkg.pricingMode === 'per_person');
const addons = tour.addons.filter((addon) => addon.isActive);
const pickups = tour.pickups.filter((pickup) => pickup.isActive);

const firstPackage = packages[0];
const initialQuote = firstPackage ? quote({ pkg: firstPackage, adults: 1 }) : null;

const widgetData = {
  slug: tour.slug,
  packages,
  addons,
  pickups,
};
const widgetJson = JSON.stringify(widgetData).replace(/</g, '\\u003c');

const fieldClass =
  'mt-1 block w-full rounded-lg border border-ink/20 bg-white px-3 py-2 text-base text-ink focus-visible:border-brand';
const labelClass = 'block text-sm font-medium text-ink';
const legendClass = 'text-base font-semibold text-ink';
---

<section
  id="book"
  class="scroll-mt-24 rounded-2xl border border-ink/10 bg-white p-5 shadow-raised sm:p-7"
>
  <h2 class="text-2xl font-bold tracking-tight text-ink">Book this tour</h2>
  <p class="mt-1 text-sm text-ink/70">
    Reserve your seats now — we will email you to confirm the details.
  </p>

  {packages.length === 0 ? (
    <p class="mt-6 rounded-lg bg-bg p-4 text-sm text-ink/80">
      This tour is not taking online bookings right now. Please call us and we will help.
    </p>
  ) : (
    <>
      <script type="application/json" id="booking-data" set:html={widgetJson} />
      <form id="booking-form" method="POST" action="/booking/reserve" class="mt-6 space-y-8">
        <input type="hidden" name="tourSlug" value={tour.slug} />
        <fieldset>
          <legend class={legendClass}>Package</legend>
          <div class="mt-3 grid gap-3">
            {packages.map((pkg, index) => (
              <label class="flex cursor-pointer gap-3 rounded-xl border border-ink/15 p-4 transition-colors hover:border-brand has-[:checked]:border-brand has-[:checked]:bg-brand/5">
                <input
                  type="radio"
                  name="packageId"
                  value={pkg.id}
                  checked={index === 0}
                  required
                  class="mt-1 size-4 accent-brand"
                />
                <span class="min-w-0">
                  <span class="block font-semibold text-ink">{pkg.name}</span>
                  {pkg.description ? (
                    <span class="mt-1 block text-sm text-ink/70">{pkg.description}</span>
                  ) : null}
                  <span class="mt-2 block text-sm text-ink/80">
                    Adult {formatCad(pkg.priceAdultCents)} · Child{' '}
                    {formatCad(pkg.priceChildCents ?? pkg.priceAdultCents)} · Senior{' '}
                    {formatCad(pkg.priceSeniorCents ?? pkg.priceAdultCents)}
                  </span>
                </span>
              </label>
            ))}
          </div>
        </fieldset>

        <fieldset>
          <legend class={legendClass}>Date</legend>
          <p class="mt-1 text-sm text-ink/70">Morning departures, grouped by week.</p>
          <div id="booking-departures" class="mt-3 space-y-4" aria-live="polite">
            <p class="text-sm text-ink/70">Loading available dates…</p>
          </div>
          <noscript>
            <p class="mt-2 text-sm text-ink/70">
              Please enable JavaScript to see the available dates, or call us to book.
            </p>
          </noscript>
        </fieldset>

        <fieldset>
          <legend class={legendClass}>People</legend>
          <p class="mt-1 text-sm text-ink/70">
            Choose everyone in your group. At least one person.
          </p>
          <div class="mt-3 grid gap-4 sm:grid-cols-3">
            {[
              { name: 'adults', label: 'Adults', value: 1 },
              { name: 'children', label: 'Children', value: 0 },
              { name: 'seniors', label: 'Seniors', value: 0 },
            ].map((group) => (
              <div>
                <label for={`booking-${group.name}`} class={labelClass}>
                  {group.label}
                </label>
                <div class="mt-1 flex items-center rounded-lg border border-ink/20 bg-white">
                  <button
                    type="button"
                    data-step="-1"
                    data-target={group.name}
                    aria-label={`One fewer ${group.label.toLowerCase()}`}
                    class="size-11 rounded-l-lg text-xl text-ink hover:bg-bg"
                  >
                    −
                  </button>
                  <input
                    id={`booking-${group.name}`}
                    name={group.name}
                    type="number"
                    inputmode="numeric"
                    min="0"
                    max="7"
                    step="1"
                    value={group.value}
                    class="h-11 w-full border-0 bg-transparent text-center text-base text-ink focus-visible:outline-0"
                  />
                  <button
                    type="button"
                    data-step="1"
                    data-target={group.name}
                    aria-label={`One more ${group.label.toLowerCase()}`}
                    class="size-11 rounded-r-lg text-xl text-ink hover:bg-bg"
                  >
                    +
                  </button>
                </div>
              </div>
            ))}
          </div>
        </fieldset>

        {addons.length > 0 ? (
          <fieldset>
            <legend class={legendClass}>Extras</legend>
            <input type="hidden" name="addons" value="[]" />
            <div class="mt-3 space-y-3">
              {addons.map((addon) => (
                <div class="rounded-xl border border-ink/15 p-4">
                  {addon.pricing === 'per_booking' ? (
                    <label class="flex items-start gap-3">
                      <input
                        type="checkbox"
                        data-addon-per-booking={addon.id}
                        class="mt-1 size-4 accent-brand"
                      />
                      <span>
                        <span class="block font-medium text-ink">{addon.name}</span>
                        <span class="block text-sm text-ink/70">
                          {formatCad(addon.priceCents)} per booking
                        </span>
                      </span>
                    </label>
                  ) : (
                    <div class="flex flex-wrap items-center justify-between gap-3">
                      <label for={`addon-${addon.id}`} class="font-medium text-ink">
                        {addon.name}
                        <span class="block text-sm font-normal text-ink/70">
                          {formatCad(addon.priceCents)} per person
                        </span>
                      </label>
                      <input
                        id={`addon-${addon.id}`}
                        data-addon-quantity={addon.id}
                        type="number"
                        inputmode="numeric"
                        min="0"
                        max="7"
                        step="1"
                        value="0"
                        class="h-11 w-20 rounded-lg border border-ink/20 bg-white px-3 text-center text-base text-ink"
                      />
                    </div>
                  )}
                </div>
              ))}
            </div>
          </fieldset>
        ) : null}

        {pickups.length > 0 ? (
          <div>
            <label for="booking-pickup" class={labelClass}>
              Pickup location
            </label>
            <select id="booking-pickup" name="pickupLocationId" required class={fieldClass}>
              {pickups.map((pickup) => (
                <option value={pickup.id}>
                  {pickup.name}
                  {pickup.pickupTime ? ` — ${pickup.pickupTime}` : ''}
                </option>
              ))}
            </select>
          </div>
        ) : null}

        <fieldset>
          <legend class={legendClass}>Your details</legend>
          <div class="mt-3 grid gap-4 sm:grid-cols-2">
            <div class="sm:col-span-2">
              <label for="booking-name" class={labelClass}>
                Full name
              </label>
              <input
                id="booking-name"
                name="customerName"
                type="text"
                autocomplete="name"
                minlength="2"
                maxlength="80"
                required
                class={fieldClass}
              />
            </div>
            <div>
              <label for="booking-email" class={labelClass}>
                Email
              </label>
              <input
                id="booking-email"
                name="customerEmail"
                type="email"
                autocomplete="email"
                maxlength="254"
                required
                class={fieldClass}
              />
            </div>
            <div>
              <label for="booking-phone" class={labelClass}>
                Phone
              </label>
              <input
                id="booking-phone"
                name="customerPhone"
                type="tel"
                autocomplete="tel"
                minlength="7"
                maxlength="20"
                required
                class={fieldClass}
              />
            </div>
            <div class="sm:col-span-2">
              <label for="booking-notes" class={labelClass}>
                Notes <span class="font-normal text-ink/70">(optional)</span>
              </label>
              <textarea
                id="booking-notes"
                name="notes"
                rows="3"
                maxlength="500"
                placeholder="Anything we should know? Wheelchair, stroller, dietary needs…"
                class={fieldClass}
              ></textarea>
            </div>
          </div>
        </fieldset>

        <div class="hidden" aria-hidden="true">
          <label for="booking-website">Website</label>
          <input
            id="booking-website"
            name="honeypot"
            type="text"
            tabindex="-1"
            autocomplete="off"
          />
        </div>

        <div class="rounded-xl bg-bg p-4 sm:p-5">
          <h3 class="text-base font-semibold text-ink">Your price</h3>
          <div id="booking-summary" class="mt-3" aria-live="polite" aria-atomic="true">
            {initialQuote ? (
              <dl class="space-y-2 text-sm">
                {initialQuote.lines.map((line) => (
                  <div class="flex items-baseline justify-between gap-4">
                    <dt class="text-ink/80">
                      {line.label} × {line.quantity}
                    </dt>
                    <dd class="tabular-nums text-ink">{formatCad(line.totalCents)}</dd>
                  </div>
                ))}
                <div class="flex items-baseline justify-between gap-4 border-t border-ink/10 pt-2">
                  <dt class="text-ink/80">Subtotal</dt>
                  <dd class="tabular-nums text-ink">{formatCad(initialQuote.subtotalCents)}</dd>
                </div>
                <div class="flex items-baseline justify-between gap-4">
                  <dt class="text-ink/80">HST (13%)</dt>
                  <dd class="tabular-nums text-ink">{formatCad(initialQuote.taxCents)}</dd>
                </div>
                <div class="flex items-baseline justify-between gap-4 text-base font-semibold">
                  <dt>Total</dt>
                  <dd class="tabular-nums">{formatCad(initialQuote.totalCents)}</dd>
                </div>
                <p class="pt-1 text-xs text-ink/70">Price shown includes HST.</p>
              </dl>
            ) : (
              <p class="text-sm text-ink/70">Choose your package and people to see the price.</p>
            )}
          </div>
        </div>

        <div class="space-y-3">
          <button
            id="booking-submit"
            type="submit"
            disabled
            class="w-full rounded-pill bg-brand px-6 py-3 text-base font-semibold text-bg shadow-raised transition-colors hover:bg-ink focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-brand disabled:cursor-not-allowed disabled:opacity-60"
          >
            Reserve seats
          </button>
          <p id="booking-blocked" class="text-sm text-ink/70" aria-live="polite">
            Choose a date to continue.
          </p>
          <p
            id="booking-error"
            class="hidden rounded-lg border border-red-300 bg-red-50 p-3 text-sm text-red-800"
            aria-live="polite"
            aria-atomic="true"
          ></p>
        </div>
      </form>
    </>
  )}
</section>

<script>
  import { actions, isInputError, type ActionError } from 'astro:actions';

  import { messageForCode, readErrorCode } from '../../lib/booking-errors';
  import { weekOfLabel } from '../../lib/datetime';
  import { formatCad } from '../../lib/format';
  import { quote } from '../../lib/pricing';
  import type { Addon, AvailabilitySlot, Package, PickupLocation } from '../../lib/types';

  interface WidgetData {
    slug: string;
    packages: Package[];
    addons: Addon[];
    pickups: PickupLocation[];
  }

  const TORONTO_TIME_ZONE = 'America/Toronto';
  const MAX_PEOPLE = 7;

  const dayFormatter = new Intl.DateTimeFormat('en-CA', {
    timeZone: TORONTO_TIME_ZONE,
    weekday: 'short',
    month: 'short',
    day: 'numeric',
  });
  const timeFormatter = new Intl.DateTimeFormat('en-CA', {
    timeZone: TORONTO_TIME_ZONE,
    hour: 'numeric',
    minute: '2-digit',
  });

  function isRecord(value: unknown): value is Record<string, unknown> {
    return typeof value === 'object' && value !== null;
  }

  function readWidgetData(): WidgetData | null {
    const element = document.getElementById('booking-data');
    if (!element || !element.textContent) return null;

    try {
      const parsed: unknown = JSON.parse(element.textContent);
      if (
        !isRecord(parsed) ||
        typeof parsed.slug !== 'string' ||
        !Array.isArray(parsed.packages) ||
        !Array.isArray(parsed.addons) ||
        !Array.isArray(parsed.pickups)
      ) {
        return null;
      }
      return parsed as unknown as WidgetData;
    } catch {
      return null;
    }
  }

  function isAvailabilitySlot(value: unknown): value is AvailabilitySlot {
    return (
      isRecord(value) &&
      typeof value.departureId === 'string' &&
      typeof value.startsAt === 'string' &&
      typeof value.seatsLeft === 'number'
    );
  }

  function torontoDateParts(date: Date): { year: number; month: number; day: number } {
    const parts = new Intl.DateTimeFormat('en-CA', {
      timeZone: TORONTO_TIME_ZONE,
      year: 'numeric',
      month: '2-digit',
      day: '2-digit',
    }).formatToParts(date);

    const record: Record<string, string> = {};
    for (const part of parts) record[part.type] = part.value;

    return {
      year: Number(record.year ?? '1970'),
      month: Number(record.month ?? '01'),
      day: Number(record.day ?? '01'),
    };
  }

  function weekKey(iso: string): string {
    const { year, month, day } = torontoDateParts(new Date(iso));
    const local = new Date(Date.UTC(year, month - 1, day, 12));
    const weekday = local.getUTCDay();
    const daysSinceMonday = (weekday + 6) % 7;
    const monday = new Date(local.getTime() - daysSinceMonday * 24 * 60 * 60 * 1000);
    return monday.toISOString().slice(0, 10);
  }

  function describeError(error: ActionError): string {
    if (isInputError(error)) {
      for (const messages of Object.values(error.fields)) {
        const first = messages?.[0];
        if (first) return first;
      }
    }
    return error.message || 'Something went wrong. Please try again or call us.';
  }

  function init(form: HTMLFormElement, data: WidgetData): void {
    const submitElement = form.querySelector<HTMLButtonElement>('#booking-submit');
    const blockedElement = document.getElementById('booking-blocked');
    const errorBoxElement = document.getElementById('booking-error');
    const summaryElement = document.getElementById('booking-summary');
    const departureBoxElement = document.getElementById('booking-departures');
    const addonsInput = form.querySelector<HTMLInputElement>('input[name="addons"]');

    if (
      !submitElement ||
      !blockedElement ||
      !errorBoxElement ||
      !summaryElement ||
      !departureBoxElement
    ) {
      return;
    }

    const submit = submitElement;
    const blocked = blockedElement;
    const errorBox = errorBoxElement;
    const summary = summaryElement;
    const departureBox = departureBoxElement;

    const seatsByDeparture = new Map<string, number>();
    let redirecting = false;

    function packageById(id: string): Package | null {
      return data.packages.find((pkg) => pkg.id === id) ?? null;
    }

    function selectedPackage(): Package | null {
      const checked = form.querySelector<HTMLInputElement>('input[name="packageId"]:checked');
      return checked ? packageById(checked.value) : (data.packages[0] ?? null);
    }

    function countOf(name: string): number {
      const input = form.querySelector<HTMLInputElement>(`input[name="${name}"]`);
      const parsed = Number.parseInt(input?.value ?? '0', 10);
      if (!Number.isFinite(parsed)) return 0;
      return Math.min(Math.max(parsed, 0), MAX_PEOPLE);
    }

    function selectedAddons(): Array<{ addon: Addon; quantity: number }> {
      const picked: Array<{ addon: Addon; quantity: number }> = [];

      for (const addon of data.addons) {
        if (addon.pricing === 'per_booking') {
          const checkbox = Array.from(
            form.querySelectorAll<HTMLInputElement>('[data-addon-per-booking]'),
          ).find((element) => element.dataset.addonPerBooking === addon.id);
          if (checkbox?.checked) picked.push({ addon, quantity: 1 });
        } else {
          const input = Array.from(
            form.querySelectorAll<HTMLInputElement>('[data-addon-quantity]'),
          ).find((element) => element.dataset.addonQuantity === addon.id);
          const quantity = Math.min(Math.max(Number.parseInt(input?.value ?? '0', 10) || 0, 0), 7);
          if (quantity > 0) picked.push({ addon, quantity });
        }
      }

      return picked;
    }

    function syncAddonsField(): void {
      if (!addonsInput) return;
      addonsInput.value = JSON.stringify(
        selectedAddons().map(({ addon, quantity }) => ({
          addonId: addon.id,
          quantity,
        })),
      );
    }

    function addSummaryRow(
      list: HTMLDListElement,
      label: string,
      value: string,
      strong = false,
    ): void {
      const row = document.createElement('div');
      row.className = strong
        ? 'flex items-baseline justify-between gap-4 border-t border-ink/10 pt-2 text-base font-semibold'
        : 'flex items-baseline justify-between gap-4';

      const term = document.createElement('dt');
      if (!strong) term.className = 'text-ink/80';
      term.textContent = label;

      const description = document.createElement('dd');
      description.className = strong ? 'tabular-nums' : 'tabular-nums text-ink';
      description.textContent = value;

      row.append(term, description);
      list.append(row);
    }

    function renderSummary(): ReturnType<typeof quote> | null {
      const pkg = selectedPackage();
      summary.replaceChildren();

      if (!pkg) {
        const message = document.createElement('p');
        message.className = 'text-sm text-ink/70';
        message.textContent = 'Choose your package and people to see the price.';
        summary.append(message);
        return null;
      }

      let result: ReturnType<typeof quote>;
      try {
        result = quote({
          pkg,
          addons: selectedAddons(),
          adults: countOf('adults'),
          children: countOf('children'),
          seniors: countOf('seniors'),
        });
      } catch {
        const message = document.createElement('p');
        message.className = 'text-sm text-ink/70';
        message.textContent = 'Choose your package and people to see the price.';
        summary.append(message);
        return null;
      }

      const list = document.createElement('dl');
      list.className = 'space-y-2 text-sm';

      if (result.lines.length === 0) {
        const message = document.createElement('p');
        message.className = 'text-sm text-ink/70';
        message.textContent = 'Add at least one person to see the price.';
        summary.append(message);
        return result;
      }

      for (const line of result.lines) {
        addSummaryRow(list, `${line.label} × ${line.quantity}`, formatCad(line.totalCents));
      }

      addSummaryRow(list, 'Subtotal', formatCad(result.subtotalCents));
      addSummaryRow(list, 'HST (13%)', formatCad(result.taxCents));
      addSummaryRow(list, 'Total', formatCad(result.totalCents), true);

      const note = document.createElement('p');
      note.className = 'pt-1 text-xs text-ink/70';
      note.textContent = 'Price shown includes HST.';
      list.append(note);

      summary.append(list);
      return result;
    }

    function update(): void {
      const quoteResult = renderSummary();
      syncAddonsField();

      const pkg = selectedPackage();
      const people = countOf('adults') + countOf('children') + countOf('seniors');
      const checked = form.querySelector<HTMLInputElement>('input[name="departureId"]:checked');
      const seats = checked ? (seatsByDeparture.get(checked.value) ?? 0) : null;

      let reason = '';
      if (!pkg) {
        reason = 'Choose a package to continue.';
      } else if (people < 1) {
        reason = 'Add at least one person.';
      } else if (!checked) {
        reason = 'Choose a date to continue.';
      } else if (seats !== null && people > seats) {
        reason = `Only ${seats} ${seats === 1 ? 'seat' : 'seats'} left on that date.`;
      } else if (!quoteResult) {
        reason = 'We could not calculate that price. Please adjust your selection.';
      }

      submit.disabled = redirecting || reason !== '';
      blocked.textContent = reason;
    }

    function showError(message: string): void {
      if (!message) {
        errorBox.textContent = '';
        errorBox.classList.add('hidden');
        return;
      }
      errorBox.textContent = message;
      errorBox.classList.remove('hidden');
    }

    function renderDepartures(slots: AvailabilitySlot[]): void {
      departureBox.replaceChildren();
      seatsByDeparture.clear();

      const available = slots.filter((slot) => slot.seatsLeft > 0);
      if (available.length === 0) {
        const message = document.createElement('p');
        message.className = 'text-sm text-ink/70';
        message.textContent =
          'No dates are available in the next six weeks. Please call us and we will find a day that works.';
        departureBox.append(message);
        return;
      }

      const weeks = new Map<string, AvailabilitySlot[]>();
      for (const slot of available) {
        const key = weekKey(slot.startsAt);
        const bucket = weeks.get(key);
        if (bucket) bucket.push(slot);
        else weeks.set(key, [slot]);
      }

      let firstRadio: HTMLInputElement | null = null;

      for (const weekSlots of weeks.values()) {
        const firstSlot = weekSlots[0];
        if (!firstSlot) continue;

        const group = document.createElement('div');

        const heading = document.createElement('h3');
        heading.className = 'text-sm font-semibold text-ink';
        heading.textContent = weekOfLabel(firstSlot.startsAt);
        group.append(heading);

        const grid = document.createElement('div');
        grid.className = 'mt-2 grid gap-2 sm:grid-cols-2';

        for (const slot of weekSlots) {
          seatsByDeparture.set(slot.departureId, slot.seatsLeft);

          const label = document.createElement('label');
          label.className =
            'flex cursor-pointer items-center gap-3 rounded-lg border border-ink/15 px-3 py-2 text-sm hover:border-brand has-[:checked]:border-brand has-[:checked]:bg-brand/5';

          const input = document.createElement('input');
          input.type = 'radio';
          input.name = 'departureId';
          input.value = slot.departureId;
          input.required = true;
          input.className = 'size-4 accent-brand';
          input.disabled = slot.seatsLeft <= 0;
          input.addEventListener('change', update);

          const text = document.createElement('span');
          text.className = 'min-w-0';
          const date = new Date(slot.startsAt);
          text.textContent = `${dayFormatter.format(date)} · ${timeFormatter.format(
            date,
          )} · ${slot.seatsLeft} ${slot.seatsLeft === 1 ? 'seat' : 'seats'} left`;

          label.append(input, text);
          grid.append(label);

          if (!firstRadio && slot.seatsLeft > 0) {
            firstRadio = input;
            input.checked = true;
          }
        }

        group.append(grid);
        departureBox.append(group);
      }

      update();
    }

    form.addEventListener('change', update);
    form.addEventListener('input', (event) => {
      if (!(event.target instanceof HTMLInputElement)) return;
      if (
        event.target.name === 'adults' ||
        event.target.name === 'children' ||
        event.target.name === 'seniors' ||
        event.target.dataset.addonQuantity !== undefined
      ) {
        update();
      }
    });

    for (const button of form.querySelectorAll<HTMLButtonElement>('button[data-step]')) {
      button.addEventListener('click', () => {
        const target = button.dataset.target;
        const step = Number.parseInt(button.dataset.step ?? '0', 10);
        if (!target || !Number.isFinite(step)) return;

        const input = form.querySelector<HTMLInputElement>(`input[name="${target}"]`);
        if (!input) return;

        const current = Number.parseInt(input.value, 10) || 0;
        input.value = String(Math.min(Math.max(current + step, 0), MAX_PEOPLE));
        update();
      });
    }

    // The server trusts no price: this is only an estimate for the customer.
    form.addEventListener('submit', async (event) => {
      event.preventDefault();
      if (submit.disabled || redirecting) return;

      showError('');
      redirecting = true;
      const originalLabel = submit.textContent;
      submit.textContent = 'Reserving…';
      update();

      try {
        const result = await actions.reserveBooking(new FormData(form));

        if (result.error) {
          showError(describeError(result.error));
        } else if (result.data?.checkoutUrl) {
          window.location.assign(result.data.checkoutUrl);
          return;
        } else if (result.data?.reference) {
          window.location.assign(
            `/booking/confirmed?ref=${encodeURIComponent(
              result.data.reference,
            )}&t=${encodeURIComponent(result.data.accessToken)}`,
          );
          return;
        } else {
          showError('We could not reserve your seats. Please try again or call us.');
        }
      } catch {
        showError('Something went wrong. Please check your connection and try again.');
      }

      redirecting = false;
      submit.textContent = originalLabel ?? 'Reserve seats';
      update();
    });

    void (async () => {
      try {
        const response = await fetch(
          `/api/availability?tour=${encodeURIComponent(data.slug)}&days=45`,
          { headers: { accept: 'application/json' } },
        );
        if (!response.ok) throw new Error('Availability request failed');

        const payload: unknown = await response.json();
        if (!Array.isArray(payload)) throw new Error('Unexpected availability response');

        renderDepartures(payload.filter(isAvailabilitySlot));
      } catch {
        departureBox.replaceChildren();
        const message = document.createElement('p');
        message.className = 'text-sm text-ink/70';
        message.textContent =
          'We could not load the calendar just now. Please refresh the page, or call us to book.';
        departureBox.append(message);
        update();
      }
    })();

    update();
  }

  // A submit that bypassed this script comes back with `?error=<code>`: show
  // the same friendly text the action would have shown.
  function showQueryError(): void {
    const errorBox = document.getElementById('booking-error');
    const code = readErrorCode(window.location.search);
    if (!errorBox || !code) return;

    errorBox.textContent = messageForCode(code);
    errorBox.classList.remove('hidden');
  }

  const data = readWidgetData();
  const form = document.querySelector<HTMLFormElement>('#booking-form');
  if (data && form) init(form, data);
  showQueryError();
</script>
