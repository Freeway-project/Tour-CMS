---
import { pickupPoints } from '../lib/home-nav';
import { isPlaceholder } from '../lib/placeholder';
import { policyLinks } from '../lib/policies';
import type { SiteSettings, Tour } from '../lib/types';
import Icon from './Icon.astro';

interface Props {
  site: SiteSettings;
  tours: Tour[];
  /** Extra bottom space so a fixed mobile bar does not cover the footer. */
  class?: string;
}

const { site, tours, class: className } = Astro.props;

const visibleTours = tours.filter((tour) => tour.status !== 'hidden');
const policies = policyLinks(site);
const pickups = pickupPoints(tours);
const hasEmail = !isPlaceholder(site.email);
const hasPhone = !isPlaceholder(site.phone);
const hasAddress = !isPlaceholder(site.address);
const hasTagline = !isPlaceholder(site.tagline);
const phoneHref = hasPhone ? `tel:${site.phone.replace(/[^\d+]/g, '')}` : '';
const year = new Date().getFullYear();
const heading = 'font-display text-sm font-bold tracking-wide text-white';
const linkClass =
  'text-white/75 transition-colors duration-150 hover:text-white hover:underline hover:decoration-accent hover:underline-offset-4 focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-white';
---

<footer class:list={['bg-brand-deep text-white', className]}>
  <div class="container-site grid gap-10 pt-16 pb-12 sm:grid-cols-2 lg:grid-cols-[1.3fr_1fr_1fr_1fr] lg:gap-12 lg:pt-20">
    <div class="max-w-xs">
      <p class="flex items-center gap-2.5">
        <span class="grid h-9 w-9 place-items-center rounded-btn border border-white/25 text-accent">
          <Icon name="falls" class="h-5 w-5" />
        </span>
        <span class="font-display text-lg font-bold">{site.name}</span>
      </p>
      {hasTagline ? <p class="mt-4 text-sm text-white/70">{site.tagline}</p> : null}
    </div>

    {visibleTours.length > 0 ? (
      <nav aria-label="Tours" class="text-sm">
        <p class={heading}>Tours</p>
        <ul class="mt-4 space-y-2.5">
          {visibleTours.map((tour) => (
            <li><a href={`/tours/${tour.slug}/`} class={linkClass}>{tour.title}</a></li>
          ))}
        </ul>
      </nav>
    ) : null}

    {hasEmail || hasPhone || hasAddress ? (
      <div class="text-sm">
        <p class={heading}>Contact</p>
        <ul class="mt-4 space-y-2.5">
          {hasEmail ? (
            <li><a href={`mailto:${site.email}`} class:list={[linkClass, 'inline-flex items-center gap-2']}><Icon name="mail" class="h-4 w-4 text-accent" />{site.email}</a></li>
          ) : null}
          {hasPhone ? (
            <li><a href={phoneHref} class:list={[linkClass, 'inline-flex items-center gap-2']}><Icon name="phone" class="h-4 w-4 text-accent" />{site.phone}</a></li>
          ) : null}
          {hasAddress ? (
            <li><address class="flex items-start gap-2 not-italic text-white/75"><Icon name="pin" class="mt-0.5 h-4 w-4 shrink-0 text-accent" />{site.address}</address></li>
          ) : null}
        </ul>
      </div>
    ) : null}

    {pickups.length > 0 ? (
      <div id="pickup" class="scroll-mt-24 text-sm">
        <p class={heading}>Pickup</p>
        <ul class="mt-4 space-y-3">
          {pickups.map((pickup) => (
            <li class="flex items-start gap-2 text-white/75">
              <Icon name="pin" class="mt-0.5 h-4 w-4 shrink-0 text-accent" />
              <span><span class="block font-medium text-white">{pickup.name}</span>{pickup.address}</span>
            </li>
          ))}
        </ul>
      </div>
    ) : null}
  </div>

  <div class="border-t border-white/10">
    <div class="container-site flex flex-col gap-3 py-6 text-xs text-white/65 sm:flex-row sm:items-center sm:justify-between">
      <p>© {year} {site.name}</p>
      {policies.length > 0 ? (
        <nav aria-label="Policies">
          <ul class="flex flex-wrap gap-x-5 gap-y-2">
            {policies.map((policy) => (
              <li><a href={policy.href} class={linkClass}>{policy.label}</a></li>
            ))}
          </ul>
        </nav>
      ) : null}
    </div>
  </div>
</footer>
