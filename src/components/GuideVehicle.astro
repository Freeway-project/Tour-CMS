---
import { renderMarkdown } from '../lib/markdown';
import { isPlaceholder } from '../lib/placeholder';
import type { SiteSettings } from '../lib/types';
import Photo from './Photo.astro';
import SectionHeading from './SectionHeading.astro';

interface Props {
  site: SiteSettings;
  /** Classes for the section (width, spacing). */
  class?: string;
  /** Classes for a full-width band around the section (background). */
  bandClass?: string;
}

const { site, class: className, bandClass } = Astro.props;
const guide = !isPlaceholder(site.guide.name) && !isPlaceholder(site.guide.bio) ? site.guide : null;
const vehicle = !isPlaceholder(site.vehicle.text) ? site.vehicle : null;
const card = 'overflow-hidden rounded-card border border-ink/10 bg-white shadow-raised';
---

{guide || vehicle ? (
  <div class={bandClass}>
  <section class={className} aria-labelledby="guide-heading">
    <SectionHeading id="guide-heading" title={guide && vehicle ? 'Meet your guide and your vehicle' : guide ? 'Meet your guide' : 'Your vehicle'} />
    <div class="mt-10 grid gap-6 md:grid-cols-2">
      {guide ? (
        <article class={card}>
          {guide.photo ? <Photo photo={guide.photo} sizes="(min-width: 640px) 50vw, 100vw" widths={[480, 800]} class="aspect-[4/3] w-full object-cover" /> : null}
          <div class="p-6 lg:p-8">
            <h3 class="heading-card">{guide.name}</h3>
            <div class="mt-2 space-y-3 text-ink/80" set:html={renderMarkdown(guide.bio)} />
          </div>
        </article>
      ) : null}
      {vehicle ? (
        <article class={card}>
          {vehicle.photo ? <Photo photo={vehicle.photo} sizes="(min-width: 640px) 50vw, 100vw" widths={[480, 800]} class="aspect-[4/3] w-full object-cover" /> : null}
          <div class="p-6 lg:p-8">
            <h3 class="heading-card">The vehicle</h3>
            <p class="mt-2 text-ink/80">{vehicle.text}</p>
          </div>
        </article>
      ) : null}
    </div>
  </section>
  </div>
) : null}
