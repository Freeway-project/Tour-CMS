---
import { formatClockTime } from '../lib/datetime';
import type { ItineraryStop } from '../lib/types';

interface Props {
  stops: ItineraryStop[];
  heading: string;
  id: string;
  /** Show only the first N moments (home page "day at a glance"). */
  limit?: number;
}

const { stops, heading, id, limit } = Astro.props;
const shown = typeof limit === 'number' ? stops.slice(0, limit) : stops;
---

{shown.length > 0 ? (
  <section class="mt-16" aria-labelledby={id}>
    <h2 id={id} class="text-2xl font-bold tracking-tight text-ink sm:text-3xl">{heading}</h2>
    <ol class="mt-6 border-l-2 border-brand/30">
      {shown.map((stop) => (
        <li class="relative pb-6 pl-6 last:pb-0">
          <span class="absolute top-1.5 -left-[7px] h-3 w-3 rounded-full bg-brand" aria-hidden="true"></span>
          <p class="text-sm font-semibold text-brand tabular-nums"><time datetime={stop.time}>{formatClockTime(stop.time)}</time></p>
          <p class="mt-0.5 font-semibold text-ink">{stop.title}</p>
          {stop.detail ? <p class="mt-1 text-sm text-ink/80">{stop.detail}</p> : null}
        </li>
      ))}
    </ol>
  </section>
) : null}
