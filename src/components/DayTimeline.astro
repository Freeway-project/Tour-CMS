---
import { formatClockTime } from '../lib/datetime';
import type { ItineraryStop } from '../lib/types';
import SectionHeading from './SectionHeading.astro';

/** The timed itinerary as a vertical timeline with numbered stops. Times come from data only. */
interface Props {
  stops: ItineraryStop[];
  heading: string;
  id: string;
  /** Show only the first N moments. */
  limit?: number;
  class?: string;
}

const { stops, heading, id, limit, class: className } = Astro.props;
const shown = typeof limit === 'number' ? stops.slice(0, limit) : stops;
---

{shown.length > 0 ? (
  <section class={className} aria-labelledby={id}>
    <SectionHeading id={id} title={heading} />
    <ol class="relative mt-8">
      {shown.map((stop, index) => (
        <li class="relative flex gap-5 pb-8 last:pb-0">
          {index < shown.length - 1 ? <span class="absolute top-10 bottom-0 left-[1.1875rem] w-px bg-teal/30" aria-hidden="true"></span> : null}
          <span class="font-display relative z-10 grid h-10 w-10 shrink-0 place-items-center rounded-full border border-teal/40 bg-white text-sm font-bold text-teal" aria-hidden="true">
            {index + 1}
          </span>
          <div class="pt-1.5">
            <p class="text-sm font-semibold text-accent-ink tabular-nums"><time datetime={stop.time}>{formatClockTime(stop.time)}</time></p>
            <p class="font-display mt-0.5 text-lg font-bold text-brand">{stop.title}</p>
            {stop.detail ? <p class="mt-1 text-ink/75">{stop.detail}</p> : null}
          </div>
        </li>
      ))}
    </ol>
  </section>
) : null}
