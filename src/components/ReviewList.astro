---
import { isPlaceholder } from '../lib/placeholder';
import type { Review } from '../lib/types';
import Icon from './Icon.astro';
import SectionHeading from './SectionHeading.astro';

/** Guest reviews as quote cards, with source and date. Placeholders never render; no totals. */
interface Props {
  reviews: Review[];
  heading?: string;
  id?: string;
  /** Cards per row on large screens. */
  columns?: 2 | 3;
  class?: string;
}

const { reviews: all, heading = 'Experiences worth sharing', id = 'reviews-heading', columns = 3, class: className } = Astro.props;
const reviews = all.filter((review) => !isPlaceholder(review.author) && !isPlaceholder(review.text));
const reviewDate = new Intl.DateTimeFormat('en-CA', { timeZone: 'UTC', year: 'numeric', month: 'long' });
const SOURCE: Record<Review['source'], string> = {
  google: 'Google review',
  tripadvisor: 'Tripadvisor review',
  viator: 'Viator review',
  direct: 'Guest review',
};
const STAR = 'M12 2.5l2.94 5.96 6.56.95-4.75 4.63 1.12 6.54L12 17.5l-5.87 3.08 1.12-6.54L2.5 9.41l6.56-.95z';
---

{reviews.length > 0 ? (
  <section class={className} aria-labelledby={id}>
    <SectionHeading id={id} title={heading} />
    <ul class:list={['mt-10 grid gap-6 md:grid-cols-2', columns === 3 && 'lg:grid-cols-3']}>
      {reviews.map((review) => {
        const date = new Date(`${review.reviewDate}T12:00:00Z`);
        const stars = Math.max(0, Math.min(5, Math.round(review.rating)));
        return (
          <li class="flex flex-col rounded-card border border-ink/10 bg-white p-6 shadow-raised lg:p-8">
            <div class="flex items-center justify-between">
              <p class="flex gap-0.5">
                {Array.from({ length: 5 }, (_, index) => (
                  <svg viewBox="0 0 24 24" class:list={['h-4 w-4', index < stars ? 'fill-accent stroke-accent-ink' : 'fill-mist stroke-ink/25']} stroke-width="1" aria-hidden="true">
                    <path d={STAR} />
                  </svg>
                ))}
                <span class="sr-only">{review.rating} out of 5</span>
              </p>
              <Icon name="quote" filled class="h-6 w-6 text-mist" />
            </div>
            <blockquote class="mt-5 flex-1 text-ink/85">{review.text}</blockquote>
            <div class="mt-6 border-t border-ink/10 pt-5">
              <p class="font-semibold text-brand">{review.location ? `${review.author}, ${review.location}` : review.author}</p>
              <p class="mt-0.5 text-xs text-ink/70">
                {SOURCE[review.source]}
                {!Number.isNaN(date.getTime()) ? <> · <time datetime={review.reviewDate}>{reviewDate.format(date)}</time></> : null}
              </p>
            </div>
          </li>
        );
      })}
    </ul>
  </section>
) : null}
