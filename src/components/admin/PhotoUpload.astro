---
/**
 * Admin photo upload: the browser resizes to WebP (max 2400px) and posts
 * `intent`, `target`, `alt`, `width`, `height` and `file` to the current page.
 * The page validates the upload again on the server (`checkPhotoUpload`).
 */
interface Props {
  target: string;
  label: string;
  intent?: string;
  current?: { src: string; alt: string } | null;
}

const { target, label, intent = 'photo-upload', current = null } = Astro.props;
---

<div class="rounded border border-ink/10 p-3" data-photo-upload data-intent={intent} data-target={target}>
  <p class="text-sm font-medium text-ink">{label}</p>
  {current ? (
    <img src={current.src} alt={current.alt} width="120" height="90" class="mt-2 h-24 w-32 rounded object-cover" loading="lazy" />
  ) : (
    <p class="mt-1 text-xs text-ink/70">No photo yet: this section stays hidden on the site.</p>
  )}
  <label class="mt-2 block text-xs font-medium text-ink">Describe the photo (for screen readers)
    <input data-alt required class="mt-1 w-full rounded border border-ink/20 px-2 py-1" value={current?.alt ?? ''} />
  </label>
  <label class="mt-2 block text-xs font-medium text-ink">Photo
    <input data-file type="file" accept="image/jpeg,image/png,image/webp,image/avif" class="mt-1 w-full" />
  </label>
  <button type="button" data-upload class="mt-2 rounded bg-brand px-3 py-1 text-xs font-semibold text-bg">Upload</button>
  {current ? (
    <button type="button" data-remove class="mt-2 ml-2 rounded border border-ink/20 px-3 py-1 text-xs font-semibold text-ink">Remove</button>
  ) : null}
  <p data-status class="mt-1 text-xs text-ink/70" aria-live="polite"></p>
</div>

<script>
  async function resize(file: File, maxDim: number) {
    const img = new Image();
    const url = URL.createObjectURL(file);
    await new Promise((resolve, reject) => {
      img.onload = resolve;
      img.onerror = reject;
      img.src = url;
    });
    const scale = Math.min(1, maxDim / Math.max(img.naturalWidth, img.naturalHeight));
    const width = Math.round(img.naturalWidth * scale);
    const height = Math.round(img.naturalHeight * scale);
    const canvas = document.createElement('canvas');
    canvas.width = width;
    canvas.height = height;
    const ctx = canvas.getContext('2d');
    if (!ctx) throw new Error('no canvas');
    ctx.drawImage(img, 0, 0, width, height);
    URL.revokeObjectURL(url);
    const blob = await new Promise<Blob | null>((resolve) => canvas.toBlob(resolve, 'image/webp', 0.85));
    if (!blob) throw new Error('no blob');
    return { blob, width, height };
  }

  async function post(body: FormData, status: HTMLElement) {
    const res = await fetch(window.location.href, { method: 'POST', body });
    if (res.ok || res.redirected) window.location.reload();
    else status.textContent = 'Upload failed.';
  }

  for (const box of document.querySelectorAll<HTMLElement>('[data-photo-upload]')) {
    const fileInput = box.querySelector<HTMLInputElement>('[data-file]');
    const altInput = box.querySelector<HTMLInputElement>('[data-alt]');
    const status = box.querySelector<HTMLElement>('[data-status]');
    const intent = box.dataset.intent ?? 'photo-upload';
    const target = box.dataset.target ?? '';
    if (!fileInput || !altInput || !status) continue;

    box.querySelector('[data-upload]')?.addEventListener('click', async () => {
      const file = fileInput.files?.[0];
      if (!file) return void (status.textContent = 'Choose a photo.');
      const alt = altInput.value.trim();
      if (alt.length < 3) return void (status.textContent = 'Describe the photo first.');
      status.textContent = 'Resizing…';
      try {
        const { blob, width, height } = await resize(file, 2400);
        const body = new FormData();
        body.append('intent', intent);
        body.append('target', target);
        body.append('alt', alt);
        body.append('width', String(width));
        body.append('height', String(height));
        body.append('file', new File([blob], file.name.replace(/\.[^.]+$/, '.webp'), { type: 'image/webp' }));
        status.textContent = 'Uploading…';
        await post(body, status);
      } catch {
        status.textContent = 'Upload failed.';
      }
    });

    box.querySelector('[data-remove]')?.addEventListener('click', async () => {
      const body = new FormData();
      body.append('intent', 'photo-remove');
      body.append('target', target);
      status.textContent = 'Removing…';
      await post(body, status);
    });
  }
</script>
