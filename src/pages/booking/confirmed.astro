---
export const prerender = false;

import Site from '../../layouts/Site.astro';
import { getTours } from '../../lib/db/catalog';
import { getSiteSettings } from '../../lib/db/content';
import { getAdminClient } from '../../lib/db/admin';
import { formatTorontoDate, formatTorontoTime } from '../../lib/datetime';
import { formatCad } from '../../lib/format';
import { isStripeConfigured } from '../../lib/stripe';
import { tokensMatch } from '../../lib/tokens';

interface BookingRow {
  reference: string;
  access_token: string;
  status: string;
  payment_method: string;
  hold_expires_at: string | null;
  adults: number;
  children: number;
  seniors: number;
  total_cents: number;
  packages: { name: string } | null;
  pickup_locations: { name: string } | null;
  departures: { starts_at: string; tours: { title: string; slug: string } | null } | null;
}

const reference = (Astro.url.searchParams.get('ref') ?? '').trim();
const token = (Astro.url.searchParams.get('t') ?? '').trim();

let booking: BookingRow | null = null;
let unavailable = false;

// Both the reference and the private token are required. A wrong or missing
// token gets the same friendly "not found" as an unknown reference, so the page
// never confirms that a reference exists.
if (reference.length > 0 && token.length > 0) {
  const admin = getAdminClient();

  if (!admin) {
    unavailable = true;
  } else {
    const { data, error } = await admin
      .from('bookings')
      .select(
        'reference, access_token, status, payment_method, hold_expires_at, adults, children, seniors, total_cents, packages(name), pickup_locations(name), departures(starts_at, tours(title, slug))',
      )
      .eq('reference', reference)
      .maybeSingle();

    if (error) {
      unavailable = true;
    } else {
      const row = data as unknown as BookingRow | null;
      if (row && tokensMatch(row.access_token, token)) booking = row;
    }
  }
}

if (!booking && !unavailable) Astro.response.status = 404;
if (!booking && unavailable) Astro.response.status = 503;

const peopleParts = booking
  ? [
      booking.adults > 0 ? `${booking.adults} ${booking.adults === 1 ? 'adult' : 'adults'}` : '',
      booking.children > 0
        ? `${booking.children} ${booking.children === 1 ? 'child' : 'children'}`
        : '',
      booking.seniors > 0
        ? `${booking.seniors} ${booking.seniors === 1 ? 'senior' : 'seniors'}`
        : '',
    ].filter((part) => part.length > 0)
  : [];

const peopleTotal = booking ? booking.adults + booking.children + booking.seniors : 0;
const departure = booking?.departures ?? null;
const tourTitle = departure?.tours?.title ?? 'Your tour';
const tourSlug = departure?.tours?.slug ?? null;
const when = departure
  ? `${formatTorontoDate(departure.starts_at)} at ${formatTorontoTime(departure.starts_at)}`
  : 'We will confirm the date with you';
const pickupName = booking?.pickup_locations?.name ?? 'Pickup to be confirmed';

const holdExpired = booking?.hold_expires_at
  ? new Date(booking.hold_expires_at).getTime() <= Date.now()
  : true;
const stripeConfigured = isStripeConfigured();
const isPaid = booking?.status === 'paid';
const isPending = booking?.status === 'pending';
// A manual booking has no Checkout hold: it stays reserved until the owner acts.
const isManual = booking?.payment_method === 'manual';
const isExpired =
  booking?.status === 'expired' || (isPending && !isManual && holdExpired && stripeConfigured);
const canCompletePayment = isPending && !isManual && !holdExpired && stripeConfigured;

const title = booking
  ? isPaid
    ? 'Booking confirmed'
    : isExpired
      ? 'Reservation expired'
      : isPending && (!stripeConfigured || isManual)
        ? 'Seats reserved'
        : isPending
          ? 'Payment not finished'
          : 'Booking cancelled'
  : unavailable
    ? 'Booking unavailable'
    : 'Booking not found';

const [site, tours] = await Promise.all([getSiteSettings(), getTours()]);
---

<Site
  site={site}
  tours={tours}
  title={`${title} | ${site.name}`}
  description={`Your Niagara Falls tour reservation with ${site.name}.`}
>
  <main class="mx-auto w-full max-w-xl px-5 py-16 sm:px-6">
    <a href="/" class="text-sm font-medium text-brand hover:underline">
      ← Back to tours
    </a>

    {unavailable ? (
      <div class="mt-8">
        <h1 class="text-3xl font-bold tracking-tight text-ink">Booking look-up is unavailable</h1>
        <p class="mt-3 text-ink/80">
          We cannot check bookings right now. Please try again in a moment, or reply to your
          confirmation email and we will help.
        </p>
      </div>
    ) : booking ? (
      <div class="mt-8">
        {isPaid ? (
          <>
            <p class="text-sm font-semibold tracking-widest text-brand uppercase">Paid in full</p>
            <h1 class="mt-2 text-3xl font-bold tracking-tight text-ink">You're booked!</h1>
            <p class="mt-3 text-ink/80">
              Thank you — your payment went through and your seats are confirmed. We have emailed
              your confirmation and will see you at pickup.
            </p>
          </>
        ) : isExpired ? (
          <>
            <p class="text-sm font-semibold tracking-widest text-brand uppercase">Reservation</p>
            <h1 class="mt-2 text-3xl font-bold tracking-tight text-ink">
              This reservation expired
            </h1>
            <p class="mt-3 text-ink/80">
              Your seats were held for 30 minutes and then released, and no payment was taken.
              Please book again to choose a date.
            </p>
            {tourSlug ? (
              <p class="mt-6">
                <a href={`/tours/${tourSlug}#book`} class="font-medium text-brand hover:underline">
                  Book this tour again
                </a>
              </p>
            ) : (
              <p class="mt-6">
                <a href="/" class="font-medium text-brand hover:underline">
                  See all tours
                </a>
              </p>
            )}
          </>
        ) : isPending && (!stripeConfigured || isManual) ? (
          <>
            <p class="text-sm font-semibold tracking-widest text-brand uppercase">Seats reserved</p>
            <h1 class="mt-2 text-3xl font-bold tracking-tight text-ink">
              Thank you — your seats are reserved
            </h1>
            <p class="mt-3 text-ink/80">
              We have your reservation. We'll contact you to arrange payment and confirm the final
              details.
            </p>
          </>
        ) : isPending ? (
          <>
            <p class="text-sm font-semibold tracking-widest text-brand uppercase">Reservation</p>
            <h1 class="mt-2 text-3xl font-bold tracking-tight text-ink">Payment not finished</h1>
            <p class="mt-3 text-ink/80">
              Your seats are still held. Complete the payment to confirm your booking — the hold
              lasts 30 minutes, after which the seats are released.
            </p>
            {canCompletePayment ? (
              <form method="POST" action="/booking/pay" class="mt-6">
                <input type="hidden" name="ref" value={booking.reference} />
                <input type="hidden" name="t" value={token} />
                <button
                  type="submit"
                  class="w-full rounded-pill bg-brand px-6 py-3 text-base font-semibold text-bg shadow-raised transition-colors hover:bg-ink focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-brand sm:w-auto"
                >
                  Complete payment
                </button>
              </form>
            ) : (
              <p class="mt-6 text-sm text-ink/70">
                Online payment is unavailable right now. Please reply to your confirmation email and
                we will help.
              </p>
            )}
          </>
        ) : (
          <>
            <p class="text-sm font-semibold tracking-widest text-brand uppercase">Reservation</p>
            <h1 class="mt-2 text-3xl font-bold tracking-tight text-ink">
              This booking was cancelled
            </h1>
            <p class="mt-3 text-ink/80">
              This booking is no longer active. Please reply to your confirmation email if you think
              this is a mistake.
            </p>
          </>
        )}

        <dl class="mt-8 space-y-4 rounded-2xl border border-ink/10 bg-white p-5">
          <div>
            <dt class="text-xs font-semibold tracking-wide text-ink/70 uppercase">
              Booking reference
            </dt>
            <dd class="mt-1 font-mono text-xl font-semibold tracking-wide text-ink">
              {booking.reference}
            </dd>
          </div>
          <div>
            <dt class="text-xs font-semibold tracking-wide text-ink/70 uppercase">Tour</dt>
            <dd class="mt-1 text-ink">
              {tourTitle}
              {booking.packages ? ` — ${booking.packages.name}` : ''}
            </dd>
          </div>
          <div>
            <dt class="text-xs font-semibold tracking-wide text-ink/70 uppercase">Date and time</dt>
            <dd class="mt-1 text-ink">{when} (Toronto time)</dd>
          </div>
          <div>
            <dt class="text-xs font-semibold tracking-wide text-ink/70 uppercase">People</dt>
            <dd class="mt-1 text-ink">
              {peopleParts.join(', ')} ({peopleTotal} {peopleTotal === 1 ? 'person' : 'people'})
            </dd>
          </div>
          <div>
            <dt class="text-xs font-semibold tracking-wide text-ink/70 uppercase">Pickup</dt>
            <dd class="mt-1 text-ink">{pickupName}</dd>
          </div>
          <div class="border-t border-ink/10 pt-4">
            <dt class="text-xs font-semibold tracking-wide text-ink/70 uppercase">
              Total including HST
            </dt>
            <dd class="mt-1 text-xl font-semibold text-ink">{formatCad(booking.total_cents)}</dd>
          </div>
        </dl>

        <p class="mt-6 text-sm text-ink/70">
          Keep this page private. If you need to change anything, reply to your confirmation email
          with the reference above.
        </p>
      </div>
    ) : (
      <div class="mt-8">
        <h1 class="text-3xl font-bold tracking-tight text-ink">We could not find that booking</h1>
        <p class="mt-3 text-ink/80">
          Check the link in your confirmation email. It includes your booking reference and a
          private code, so the page can only be opened from that email. If it still does not work,
          reply to the email and we will find it for you.
        </p>
        <p class="mt-6">
          <a href="/" class="font-medium text-brand hover:underline">
            See all tours
          </a>
        </p>
      </div>
    )}
  </main>
</Site>
