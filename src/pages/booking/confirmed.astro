---
export const prerender = false;

import Base from '../../layouts/Base.astro';
import { getAdminClient } from '../../lib/db/admin';
import { formatTorontoDate, formatTorontoTime } from '../../lib/datetime';
import { formatCad } from '../../lib/format';
import '../../styles/global.css';

interface BookingRow {
  reference: string;
  adults: number;
  children: number;
  seniors: number;
  total_cents: number;
  packages: { name: string } | null;
  pickup_locations: { name: string } | null;
  departures: { starts_at: string; tours: { title: string } | null } | null;
}

const reference = (Astro.url.searchParams.get('ref') ?? '').trim();

let booking: BookingRow | null = null;
let unavailable = false;

if (reference.length > 0) {
  const admin = getAdminClient();

  if (!admin) {
    unavailable = true;
  } else {
    // Exact-reference lookup only: a guess must never reveal another booking.
    const { data, error } = await admin
      .from('bookings')
      .select(
        'reference, adults, children, seniors, total_cents, packages(name), pickup_locations(name), departures(starts_at, tours(title))',
      )
      .eq('reference', reference)
      .maybeSingle();

    if (error) unavailable = true;
    else booking = data as unknown as BookingRow | null;
  }
}

if (!booking && !unavailable) Astro.response.status = 404;
if (!booking && unavailable) Astro.response.status = 503;

const peopleParts = booking
  ? [
      booking.adults > 0 ? `${booking.adults} ${booking.adults === 1 ? 'adult' : 'adults'}` : '',
      booking.children > 0
        ? `${booking.children} ${booking.children === 1 ? 'child' : 'children'}`
        : '',
      booking.seniors > 0
        ? `${booking.seniors} ${booking.seniors === 1 ? 'senior' : 'seniors'}`
        : '',
    ].filter((part) => part.length > 0)
  : [];

const peopleTotal = booking ? booking.adults + booking.children + booking.seniors : 0;
const departure = booking?.departures ?? null;
const tourTitle = departure?.tours?.title ?? 'Your tour';
const when = departure
  ? `${formatTorontoDate(departure.starts_at)} at ${formatTorontoTime(departure.starts_at)}`
  : 'We will confirm the date with you';
const pickupName = booking?.pickup_locations?.name ?? 'Pickup to be confirmed';

const title = booking
  ? 'Booking confirmed'
  : unavailable
    ? 'Booking unavailable'
    : 'Booking not found';
---

<Base
  title={`${title} | Toronto Niagara Tours`}
  description="Your Niagara Falls tour reservation with Toronto Niagara Tours."
>
  <main class="mx-auto w-full max-w-xl px-5 py-16 sm:px-6">
    <a href="/" class="text-sm font-medium text-brand hover:underline">
      ← Back to tours
    </a>

    {unavailable ? (
      <div class="mt-8">
        <h1 class="text-3xl font-bold tracking-tight text-ink">Booking look-up is unavailable</h1>
        <p class="mt-3 text-ink/80">
          We cannot check bookings right now. Please try again in a moment, or reply to your
          confirmation email and we will help.
        </p>
      </div>
    ) : booking ? (
      <div class="mt-8">
        <p class="text-sm font-semibold tracking-widest text-brand uppercase">Seats reserved</p>
        <h1 class="mt-2 text-3xl font-bold tracking-tight text-ink">Thank you — you are booked</h1>
        <p class="mt-3 text-ink/80">
          We have your reservation. We will email you shortly with the final details.
        </p>

        <dl class="mt-8 space-y-4 rounded-2xl border border-ink/10 bg-white p-5">
          <div>
            <dt class="text-xs font-semibold tracking-wide text-ink/70 uppercase">
              Booking reference
            </dt>
            <dd class="mt-1 font-mono text-xl font-semibold tracking-wide text-ink">
              {booking.reference}
            </dd>
          </div>
          <div>
            <dt class="text-xs font-semibold tracking-wide text-ink/70 uppercase">Tour</dt>
            <dd class="mt-1 text-ink">
              {tourTitle}
              {booking.packages ? ` — ${booking.packages.name}` : ''}
            </dd>
          </div>
          <div>
            <dt class="text-xs font-semibold tracking-wide text-ink/70 uppercase">Date and time</dt>
            <dd class="mt-1 text-ink">{when} (Toronto time)</dd>
          </div>
          <div>
            <dt class="text-xs font-semibold tracking-wide text-ink/70 uppercase">People</dt>
            <dd class="mt-1 text-ink">
              {peopleParts.join(', ')} ({peopleTotal} {peopleTotal === 1 ? 'person' : 'people'})
            </dd>
          </div>
          <div>
            <dt class="text-xs font-semibold tracking-wide text-ink/70 uppercase">Pickup</dt>
            <dd class="mt-1 text-ink">{pickupName}</dd>
          </div>
          <div class="border-t border-ink/10 pt-4">
            <dt class="text-xs font-semibold tracking-wide text-ink/70 uppercase">
              Total including HST
            </dt>
            <dd class="mt-1 text-xl font-semibold text-ink">{formatCad(booking.total_cents)}</dd>
          </div>
        </dl>

        <p class="mt-6 text-sm text-ink/70">
          Keep your reference handy. If you need to change anything, reply to your confirmation
          email with the reference above.
        </p>
      </div>
    ) : (
      <div class="mt-8">
        <h1 class="text-3xl font-bold tracking-tight text-ink">We could not find that booking</h1>
        <p class="mt-3 text-ink/80">
          Check the booking reference in your confirmation email. References look like
          <span class="font-mono"> TN-7K3F9Q</span>. If it still does not work, reply to your email
          and we will find it for you.
        </p>
        <p class="mt-6">
          <a href="/" class="font-medium text-brand hover:underline">
            See all tours
          </a>
        </p>
      </div>
    )}
  </main>
</Base>
