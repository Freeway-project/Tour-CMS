---
export const prerender = true;

import BookingWidget from '../../components/booking/BookingWidget.astro';
import InquiryForm from '../../components/booking/InquiryForm.astro';
import DayTimeline from '../../components/DayTimeline.astro';
import FaqList from '../../components/FaqList.astro';
import GuideVehicle from '../../components/GuideVehicle.astro';
import HeroBanner from '../../components/HeroBanner.astro';
import Photo from '../../components/Photo.astro';
import Site from '../../layouts/Site.astro';
import { getTours } from '../../lib/db/catalog';
import { getFaqs, getReviews, getSiteSettings } from '../../lib/db/content';
import { formatClockTime } from '../../lib/datetime';
import { formatCad } from '../../lib/format';
import { renderMarkdown } from '../../lib/markdown';
import { isPlaceholder } from '../../lib/placeholder';
import { hasPolicy } from '../../lib/policies';
import { heroImage } from '../../lib/photos';
import { fromPrice, withHst } from '../../lib/pricing';
import { tourFacts, tourInclusions } from '../../lib/tour-facts';
import type { Tour } from '../../lib/types';

export async function getStaticPaths() {
  const tours = await getTours();

  return tours
    .filter((tour) => tour.status !== 'hidden')
    .map((tour) => ({ params: { slug: tour.slug }, props: { tour, tours } }));
}

interface Props {
  tour: Tour;
  tours: Tour[];
}

const { tour, tours } = Astro.props;

const site = await getSiteSettings();
const showCancellation = hasPolicy(site, 'cancellationPolicy');

const allReviews = await getReviews();
const reviews = allReviews
  .filter((entry) => entry.featured)
  .sort((a, b) => b.reviewDate.localeCompare(a.reviewDate))
  .slice(0, 3);

const faqs = await getFaqs();

const activePackages = tour.packages.filter((pkg) => pkg.isActive);
const pickups = tour.pickups.filter((pickup) => pickup.isActive);
const lowest = fromPrice(tour);

// Only verified platform totals count. A rating with no reviews is a placeholder,
// even if a score was typed in, and must not reach visitors or JSON-LD.
const ratedPlatforms = site.ratings.filter(
  (rating) => !isPlaceholder(rating.platform) && !isPlaceholder(rating.url) && rating.count > 0,
);
const totalReviews = ratedPlatforms.reduce((sum, rating) => sum + rating.count, 0);
const averageRating =
  totalReviews > 0
    ? ratedPlatforms.reduce((sum, rating) => sum + rating.score * rating.count, 0) / totalReviews
    : null;

// Google rejects an `AggregateRating` with `reviewCount: 0`, so omit it entirely
// until the owner has published verified platform totals.
const structuredRating =
  totalReviews > 0 && averageRating !== null
    ? { ratingValue: averageRating, reviewCount: totalReviews }
    : null;

const ratingSummary =
  totalReviews > 0 && averageRating !== null
    ? `${averageRating.toFixed(1)} average from ${totalReviews.toLocaleString('en-CA')} guest reviews`
    : null;

const facts = tourFacts(tour);
const bannerPhoto = heroImage(tour.images) ?? tour.images[0] ?? null;
const gallery = tour.images.filter((image) => image !== bannerPhoto);
const inclusions = tourInclusions(tour);
const excludes = tour.excludes.filter((item) => !isPlaceholder(item));
const bannerFacts = [
  facts.guests,
  facts.duration,
  facts.pickup,
  showCancellation ? 'Free cancellation' : null,
  ratingSummary,
].filter((fact): fact is string => Boolean(fact));

const description = tour.shortDescription.slice(0, 158);
const title = `${tour.title} | ${site.name}`;
const canonicalUrl = new URL(
  Astro.url.pathname,
  Astro.site ?? new URL('https://torontoniagara.ca'),
);

const productLd: Record<string, unknown> = {
  '@context': 'https://schema.org',
  '@type': 'Product',
  name: tour.title,
  description: tour.shortDescription,
  url: canonicalUrl.href,
};

if (lowest) {
  productLd.offers = {
    '@type': 'Offer',
    price: (lowest.cents / 100).toFixed(2),
    priceCurrency: 'CAD',
    availability: 'https://schema.org/InStock',
    url: canonicalUrl.href,
  };
}

if (structuredRating) {
  productLd.aggregateRating = {
    '@type': 'AggregateRating',
    ratingValue: structuredRating.ratingValue.toFixed(1),
    reviewCount: structuredRating.reviewCount,
  };
}

const productLdJson = JSON.stringify(productLd).replace(/</g, '\\u003c');
---

<Site
  title={title}
  description={description}
  site={site}
  tours={tours}
  footerClass="pb-24 lg:pb-0"
>
  <Fragment slot="head">
    <script type="application/ld+json" set:html={productLdJson} />
  </Fragment>

  <HeroBanner
    photo={bannerPhoto}
    heading={tour.title}
    lead={tour.shortDescription}
    facts={bannerFacts}
    price={facts.price}
    priceUnit={facts.priceUnit}
    cta={{ href: '#book', label: tour.isPrivate ? 'Ask for your date' : 'Check dates' }}
  />

  <main class="mx-auto w-full max-w-3xl px-5 pt-10 pb-16 sm:px-6">
    <div>
      {tour.isPrivate ? <InquiryForm tour={tour} /> : <BookingWidget tour={tour} />}
      {showCancellation ? (
        <p class="mt-3 text-sm text-ink/70">
          <a
            href="/cancellation-policy/"
            class="font-medium text-brand hover:underline focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-brand"
          >
            Read the cancellation policy
          </a>
        </p>
      ) : null}
    </div>

    {gallery.length > 0 ? (
      <section class="mt-14" aria-labelledby="photos-heading">
        <h2 id="photos-heading" class="text-2xl font-bold tracking-tight text-ink">Photos</h2>
        <ul class="-mx-5 mt-4 flex snap-x snap-mandatory gap-3 overflow-x-auto px-5 pb-2 sm:mx-0 sm:px-0" tabindex="0" aria-label="Tour photos, scroll sideways">
          {gallery.map((image) => (
            <li class="w-[80%] shrink-0 snap-start sm:w-[45%]">
              <Photo photo={image} sizes="(min-width: 640px) 360px, 80vw" widths={[480, 800]} class="aspect-[4/3] w-full rounded-xl object-cover" />
            </li>
          ))}
        </ul>
      </section>
    ) : null}

    <DayTimeline stops={tour.itinerary} heading="Your day" id="day-heading" />

    {inclusions.length > 0 || excludes.length > 0 ? (
      <section class="mt-16" aria-labelledby="included-heading">
        <h2 id="included-heading" class="text-2xl font-bold tracking-tight text-ink">What's included</h2>
        <div class="mt-6 grid gap-6 sm:grid-cols-2">
          {inclusions.length > 0 ? (
            <div>
              <h3 class="font-semibold text-ink">Included</h3>
              <ul class="mt-2 space-y-1.5 text-sm text-ink/80">
                {inclusions.map((item) => (
                  <li class="flex gap-2"><span aria-hidden="true" class="font-semibold text-brand">✓</span><span>{item}</span></li>
                ))}
              </ul>
            </div>
          ) : null}
          {excludes.length > 0 ? (
            <div>
              <h3 class="font-semibold text-ink">Not included</h3>
              <ul class="mt-2 space-y-1.5 text-sm text-ink/80">
                {excludes.map((item) => (
                  <li class="flex gap-2"><span aria-hidden="true" class="font-semibold text-ink/50">–</span><span>{item}</span></li>
                ))}
              </ul>
            </div>
          ) : null}
        </div>
        {tour.importantInfo && !isPlaceholder(tour.importantInfo) ? (
          <p class="mt-6 rounded-xl bg-brand/5 p-4 text-sm text-ink">{tour.importantInfo}</p>
        ) : null}
      </section>
    ) : null}

    <section class="mt-16" aria-labelledby="prices-heading">
      <h2 id="prices-heading" class="text-2xl font-bold tracking-tight text-ink">Prices, including HST</h2>
      <div class="mt-4 grid gap-4 sm:grid-cols-2">
        {activePackages.map((pkg) => (
          <article class="rounded-2xl border border-ink/10 bg-white p-5">
            <h3 class="text-lg font-semibold text-ink">{pkg.name}</h3>
            {pkg.description ? <p class="mt-1 text-sm text-ink/70">{pkg.description}</p> : null}
            {pkg.pricingMode === 'per_group' ? (
              <p class="mt-3 text-ink">
                <span class="text-xl font-semibold">{formatCad(withHst(pkg.priceAdultCents))}</span>
                <span class="text-sm text-ink/70"> per vehicle{pkg.maxPax ? `, up to ${pkg.maxPax} people` : ''}</span>
              </p>
            ) : (
              <dl class="mt-3 grid grid-cols-3 gap-2 text-sm">
                <div>
                  <dt class="text-ink/70">Adult</dt>
                  <dd class="font-semibold text-ink">{formatCad(withHst(pkg.priceAdultCents))}</dd>
                </div>
                <div>
                  <dt class="text-ink/70">Child</dt>
                  <dd class="font-semibold text-ink">{formatCad(withHst(pkg.priceChildCents ?? pkg.priceAdultCents))}</dd>
                </div>
                <div>
                  <dt class="text-ink/70">Senior</dt>
                  <dd class="font-semibold text-ink">{formatCad(withHst(pkg.priceSeniorCents ?? pkg.priceAdultCents))}</dd>
                </div>
              </dl>
            )}
          </article>
        ))}
      </div>
    </section>

    <section class="mt-16" aria-labelledby="about-heading">
      <h2 id="about-heading" class="text-2xl font-bold tracking-tight text-ink">About this tour</h2>
      <div
        class="mt-4 space-y-4 text-ink/80 [&_a]:font-medium [&_a]:text-brand [&_a]:underline"
        set:html={renderMarkdown(tour.description)}
      />
    </section>

    <section class="mt-16" aria-labelledby="pickup-heading">
      <h2 id="pickup-heading" class="text-2xl font-bold tracking-tight text-ink">Pickup</h2>
      {pickups.length > 0 ? (
        <ul class="mt-4 space-y-3">
          {pickups.map((pickup) => (
            <li class="rounded-xl border border-ink/10 bg-white p-4">
              <p class="font-semibold text-ink">{pickup.name}</p>
              <p class="mt-1 text-sm text-ink/70">{pickup.address}</p>
              {pickup.pickupTime ? <p class="mt-2 text-sm text-ink/80">Pickup at {formatClockTime(pickup.pickupTime)}</p> : null}
              {pickup.pickupNote ? <p class="mt-1 text-sm text-ink/70">{pickup.pickupNote}</p> : null}
            </li>
          ))}
        </ul>
      ) : (
        <p class="mt-4 text-ink/80">Pickup details are confirmed when you book.</p>
      )}
    </section>

    <GuideVehicle site={site} />

    {reviews.length > 0 ? (
      <section class="mt-16" aria-labelledby="reviews-heading">
        <h2 id="reviews-heading" class="text-2xl font-bold tracking-tight text-ink">What guests say</h2>
        <ul class="mt-4 grid gap-4 sm:grid-cols-2">
          {reviews.map((review) => (
            <li class="rounded-2xl border border-ink/10 bg-white p-5">
              <p class="text-brand">
                <span aria-hidden="true">{'★'.repeat(review.rating)}</span>
                <span class="sr-only">{review.rating} out of 5</span>
              </p>
              <blockquote class="mt-2 text-sm text-ink/80">{review.text}</blockquote>
              <p class="mt-3 text-sm font-medium text-ink">
                {review.location ? `${review.author}, ${review.location}` : review.author}
              </p>
            </li>
          ))}
        </ul>
      </section>
    ) : null}

    <FaqList faqs={faqs.slice(0, 8)} />
  </main>

  <div
    class="fixed inset-x-0 bottom-0 z-30 border-t border-ink/10 bg-white/95 lg:hidden"
    style="padding-bottom: env(safe-area-inset-bottom)"
  >
    <div class="mx-auto flex w-full max-w-3xl items-center justify-between gap-4 px-5 py-3">
      {facts.price ? (
        <p class="text-sm text-ink/70">
          From <strong class="text-base font-semibold text-ink">{facts.price}</strong>
          <span class="block text-xs">{facts.priceUnit}</span>
        </p>
      ) : (
        <span></span>
      )}
      <a
        href="#book"
        class="rounded-pill bg-brand px-5 py-2.5 text-sm font-semibold text-bg shadow-raised focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-brand"
      >
        {tour.isPrivate ? 'Ask for your date' : 'Check dates'}
      </a>
    </div>
  </div>
</Site>
