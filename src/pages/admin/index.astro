---
export const prerender = false;

import Base from '../../layouts/Base.astro';

const supabase = Astro.locals.supabase;
const user = Astro.locals.user;

interface DepartureRow {
  id: string;
  starts_at: string;
  capacity: number;
  tours: { title: string } | null;
}

interface BookingRow {
  id: string;
  reference: string;
  customer_name: string;
  adults: number;
  children: number;
  seniors: number;
  status: string;
  total_cents: number;
  departures: { starts_at: string; tours: { title: string } | null } | null;
}

let departures: DepartureRow[] = [];
let bookings: BookingRow[] = [];
if (supabase) {
  const { data } = await supabase
    .from('departures')
    .select('id, starts_at, capacity, tours(title)')
    .gte('starts_at', new Date().toISOString())
    .order('starts_at', { ascending: true })
    .limit(20);
  departures = (data as unknown as DepartureRow[]) ?? [];

  const { data: b } = await supabase
    .from('bookings')
    .select('id, reference, customer_name, adults, children, seniors, status, total_cents, departures(starts_at, tours(title))')
    .order('created_at', { ascending: false })
    .limit(50);
  bookings = (b as unknown as BookingRow[]) ?? [];
}
---
<Base title="Admin — Bookings" description="Manage bookings.">
  <Fragment slot="head"><meta name="robots" content="noindex" /></Fragment>
  <main class="mx-auto max-w-5xl px-6 py-10">
    <header class="flex items-center justify-between">
      <h1 class="text-2xl font-bold text-ink">Today / Bookings</h1>
      <div class="flex gap-3 text-sm">
        <a href="/admin/inquiries" class="text-brand hover:underline">Private requests</a>
        <a href="/admin/calendar" class="text-brand hover:underline">Calendar</a>
        <a href="/admin/tours" class="text-brand hover:underline">Tours</a>
        <a href="/admin/settings" class="text-brand hover:underline">Settings</a>
        <a href="/admin/faqs" class="text-brand hover:underline">FAQs</a>
        <a href="/admin/reviews" class="text-brand hover:underline">Reviews</a>
        <form method="post" action="/admin/publish"><button class="text-ink/70 hover:underline">Publish now</button></form>
        <form method="post" action="/admin/logout"><button class="text-ink/70 hover:underline">Sign out</button></form>
      </div>
    </header>
    <p class="mt-2 text-sm text-ink/70">Signed in as {user?.email ?? 'admin'}.</p>

    <section class="mt-8">
      <h2 class="text-lg font-semibold text-ink">Upcoming departures</h2>
      <ul class="mt-3 space-y-2">
        {departures.map((d) => (
          <li class="rounded border border-ink/10 bg-white p-3 text-sm">
            {d.tours?.title ?? 'Tour'} — {new Date(d.starts_at).toLocaleString('en-CA')} — capacity {d.capacity}
          </li>
        ))}
      </ul>
    </section>

    <section class="mt-8">
      <h2 class="text-lg font-semibold text-ink">Recent bookings</h2>
      <ul class="mt-3 space-y-2">
        {bookings.map((b) => (
          <li class="rounded border border-ink/10 bg-white p-3 text-sm">
            <strong>{b.reference}</strong> — {b.customer_name} — {b.adults + b.children + b.seniors} people — {b.status} — ${(b.total_cents / 100).toFixed(2)}
          </li>
        ))}
      </ul>
    </section>
  </main>
</Base>
