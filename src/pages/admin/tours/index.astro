---
export const prerender = false;

import Admin from '../../../layouts/Admin.astro';

const supabase = Astro.locals.supabase;

interface TourRow {
  id: string;
  slug: string;
  title: string;
  status: string;
  sort_order: number;
}

let tours: TourRow[] = [];
if (supabase) {
  const { data } = await supabase
    .from('tours')
    .select('id, slug, title, status, sort_order')
    .order('sort_order', { ascending: true });
  tours = (data as unknown as TourRow[]) ?? [];
}
---

<Admin title="Tours" description="Manage tours.">
  <div class="mt-4">
    <a href="/admin/tours/new" class="inline-block rounded bg-brand px-4 py-2 font-semibold text-bg">New tour</a>
  </div>
  <ul class="mt-6 space-y-2 text-sm">
    {tours.map((t) => (
      <li class="rounded border border-ink/10 bg-white p-3">
        <a href={`/admin/tours/${t.id}`} class="font-semibold text-brand hover:underline">{t.title}</a>
        — {t.slug} — {t.status}
      </li>
    ))}
  </ul>
</Admin>
