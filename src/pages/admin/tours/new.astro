---
export const prerender = false;

import { slugify } from '../../../lib/slug';
import { tourSchema, fieldErrors } from '../../../lib/admin-schemas';
import { triggerPublish } from '../../../lib/publish';
import Admin from '../../../layouts/Admin.astro';

const supabase = Astro.locals.supabase;
const waitUntil = Astro.locals.runtime?.ctx?.waitUntil;

let errors: Record<string, string> = {};
let saved = false;

if (supabase && Astro.request.method === 'POST') {
  const form = await Astro.request.formData();
  const parsed = tourSchema.safeParse(Object.fromEntries(form));
  if (!parsed.success) {
    errors = fieldErrors(parsed.error);
  } else {
    const data = parsed.data;
    const durationMinutes = data.duration_hours * 60 + data.duration_minutes_extra;
    const slug = data.slug && data.slug.length > 0 ? data.slug : slugify(data.title);
    const { data: inserted, error: insertError } = await supabase
      .from('tours')
      .insert({
        slug,
        title: data.title,
        short_description: data.short_description,
        description: data.description,
        highlights: data.highlights,
        important_info: data.important_info ?? null,
        duration_minutes: durationMinutes,
        status: data.status,
        is_private: data.is_private,
        sort_order: data.sort_order,
        hero_image_path: '',
      })
      .select('id')
      .single();

    if (insertError || !inserted) {
      errors._form = insertError?.message ?? 'Could not create the tour.';
    } else {
      await triggerPublish(supabase, waitUntil);
      return Astro.redirect(`/admin/tours/${(inserted as { id: string }).id}?saved=1`);
    }
  }
}
---

<Admin title="New tour" description="Create a tour." saved={saved}>
  {errors._form ? <p class="mt-3 text-sm text-red-600">{errors._form}</p> : null}
  <form method="post" class="mt-6 space-y-4">
    <label class="block text-sm font-medium text-ink">Title
      <input name="title" class="mt-1 w-full rounded border border-ink/20 px-3 py-2" />
      {errors.title ? <span class="text-xs text-red-600">{errors.title}</span> : null}
    </label>
    <label class="block text-sm font-medium text-ink">Slug (auto from title if blank)
      <input name="slug" class="mt-1 w-full rounded border border-ink/20 px-3 py-2" />
      {errors.slug ? <span class="text-xs text-red-600">{errors.slug}</span> : null}
    </label>
    <label class="block text-sm font-medium text-ink">Short description
      <input name="short_description" class="mt-1 w-full rounded border border-ink/20 px-3 py-2" />
      {errors.short_description ? <span class="text-xs text-red-600">{errors.short_description}</span> : null}
    </label>
    <label class="block text-sm font-medium text-ink">Description
      <textarea name="description" rows="6" class="mt-1 w-full rounded border border-ink/20 px-3 py-2"></textarea>
      {errors.description ? <span class="text-xs text-red-600">{errors.description}</span> : null}
    </label>
    <label class="block text-sm font-medium text-ink">Highlights (one per line)
      <textarea name="highlights" rows="4" class="mt-1 w-full rounded border border-ink/20 px-3 py-2"></textarea>
    </label>
    <label class="block text-sm font-medium text-ink">Includes (one per line)
      <textarea name="includes" rows="4" class="mt-1 w-full rounded border border-ink/20 px-3 py-2"></textarea>
    </label>
    <label class="block text-sm font-medium text-ink">Important info
      <textarea name="important_info" rows="3" class="mt-1 w-full rounded border border-ink/20 px-3 py-2"></textarea>
    </label>
    <div class="flex gap-3">
      <label class="block text-sm font-medium text-ink">Duration hours
        <input name="duration_hours" type="number" min="0" max="24" value="0" class="mt-1 w-full rounded border border-ink/20 px-3 py-2" />
      </label>
      <label class="block text-sm font-medium text-ink">Duration minutes
        <input name="duration_minutes_extra" type="number" min="0" max="59" value="0" class="mt-1 w-full rounded border border-ink/20 px-3 py-2" />
      </label>
    </div>
    <label class="block text-sm font-medium text-ink">Status
      <select name="status" class="mt-1 w-full rounded border border-ink/20 px-3 py-2">
        <option value="active">active</option>
        <option value="seasonal">seasonal</option>
        <option value="hidden">hidden</option>
      </select>
    </label>
    <label class="flex items-center gap-2 text-sm font-medium text-ink">
      <input type="checkbox" name="is_private" /> Private tour
    </label>
    <label class="block text-sm font-medium text-ink">Sort order
      <input name="sort_order" type="number" value="0" class="mt-1 w-full rounded border border-ink/20 px-3 py-2" />
    </label>
    <button type="submit" class="rounded bg-brand px-4 py-2 font-semibold text-bg">Create tour</button>
  </form>
</Admin>
