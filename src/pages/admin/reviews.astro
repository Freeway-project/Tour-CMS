---
export const prerender = false;

import { reviewSchema, fieldErrors } from '../../lib/admin-schemas';
import { triggerPublish } from '../../lib/publish';
import Admin from '../../layouts/Admin.astro';

const supabase = Astro.locals.supabase;
const waitUntil = Astro.locals.runtime?.ctx?.waitUntil;

interface ReviewRow {
  id: string;
  author: string;
  location: string | null;
  rating: number;
  text: string;
  review_date: string;
  source: string;
  featured: boolean;
  is_active: boolean;
}

let reviews: ReviewRow[] = [];
let saved = false;
let errors: Record<string, string> = {};

if (supabase && Astro.request.method === 'POST') {
  const form = await Astro.request.formData();
  const action = String(form.get('action') ?? 'create');
  if (action === 'create') {
    const parsed = reviewSchema.safeParse(Object.fromEntries(form));
    if (!parsed.success) {
      errors = fieldErrors(parsed.error);
    } else {
      const data = parsed.data;
      const { error: e } = await supabase.from('reviews').insert({
        author: data.author,
        location: data.location ?? null,
        rating: data.rating,
        text: data.text,
        review_date: data.review_date,
        source: data.source,
        featured: data.featured,
        is_active: data.is_active,
      });
      if (e) errors._form = e.message;
      else {
        saved = true;
        await triggerPublish(supabase, waitUntil);
      }
    }
  } else if (action === 'delete') {
    const { error: e } = await supabase.from('reviews').delete().eq('id', String(form.get('id')));
    if (e) errors._form = e.message;
    else {
      saved = true;
      await triggerPublish(supabase, waitUntil);
    }
  }
}

if (supabase) {
  const { data } = await supabase
    .from('reviews')
    .select('id, author, location, rating, text, review_date, source, featured, is_active')
    .order('sort_order', { ascending: true });
  reviews = (data as unknown as ReviewRow[]) ?? [];
}
---

<Admin title="Reviews" description="Manage reviews." saved={saved}>
  {errors._form ? <p class="mt-3 text-sm text-red-600">{errors._form}</p> : null}

  <form method="post" class="mt-6 space-y-3 rounded border border-ink/10 bg-white p-4">
    <input type="hidden" name="action" value="create" />
    <label class="block text-sm font-medium text-ink">Author
      <input name="author" class="mt-1 w-full rounded border border-ink/20 px-3 py-2" />
      {errors.author ? <span class="text-xs text-red-600">{errors.author}</span> : null}
    </label>
    <label class="block text-sm font-medium text-ink">Location
      <input name="location" class="mt-1 w-full rounded border border-ink/20 px-3 py-2" />
    </label>
    <label class="block text-sm font-medium text-ink">Rating (1-5)
      <input name="rating" type="number" min="1" max="5" value="5" class="mt-1 w-full rounded border border-ink/20 px-3 py-2" />
      {errors.rating ? <span class="text-xs text-red-600">{errors.rating}</span> : null}
    </label>
    <label class="block text-sm font-medium text-ink">Text
      <textarea name="text" rows="3" class="mt-1 w-full rounded border border-ink/20 px-3 py-2"></textarea>
      {errors.text ? <span class="text-xs text-red-600">{errors.text}</span> : null}
    </label>
    <label class="block text-sm font-medium text-ink">Date
      <input name="review_date" type="date" class="mt-1 w-full rounded border border-ink/20 px-3 py-2" />
    </label>
    <label class="block text-sm font-medium text-ink">Source
      <select name="source" class="mt-1 w-full rounded border border-ink/20 px-3 py-2">
        <option value="google">google</option>
        <option value="tripadvisor">tripadvisor</option>
        <option value="viator">viator</option>
        <option value="direct">direct</option>
      </select>
    </label>
    <label class="flex items-center gap-2 text-sm font-medium text-ink">
      <input type="checkbox" name="featured" /> Featured
    </label>
    <button type="submit" class="rounded bg-brand px-4 py-2 font-semibold text-bg">Add review</button>
  </form>

  <ul class="mt-6 space-y-3">
    {reviews.map((r) => (
      <li class="rounded border border-ink/10 bg-white p-4 text-sm">
        <strong>{r.author}</strong> — {r.rating}★ — {r.review_date}
        <p class="mt-1 text-ink/70">{r.text.slice(0, 120)}</p>
        <form method="post" class="mt-2">
          <input type="hidden" name="action" value="delete" />
          <input type="hidden" name="id" value={r.id} />
          <button type="submit" class="text-red-600 hover:underline">Delete</button>
        </form>
      </li>
    ))}
  </ul>
</Admin>
