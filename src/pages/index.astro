---
export const prerender = true;

import Button from '../components/Button.astro';
import FaqList from '../components/FaqList.astro';
import TourCard from '../components/TourCard.astro';
import Site from '../layouts/Site.astro';
import { getTours } from '../lib/db/catalog';
import { getFaqs, getReviews, getSiteSettings } from '../lib/db/content';
import { formatCadHeadline } from '../lib/format';
import { isPlaceholder } from '../lib/placeholder';
import { fromPrice, type FromPrice } from '../lib/pricing';
import type { Tour } from '../lib/types';

const site = await getSiteSettings();

const tours = await getTours();
const visibleTours = tours.filter((tour) => tour.status !== 'hidden');

const faqs = await getFaqs(null);
const reviews = (await getReviews())
  .filter((review) => !isPlaceholder(review.author) && !isPlaceholder(review.text))
  .slice(0, 3);

// The cheapest way in, across every tour the site advertises.
let from: FromPrice | null = null;
for (const tour of visibleTours) {
  const offer = fromPrice(tour);
  if (offer && (from === null || offer.cents < from.cents)) from = offer;
}

const sharedTours = visibleTours.filter(
  (tour) =>
    !tour.isPrivate &&
    tour.packages.some((pkg) => pkg.isActive && pkg.pricingMode === 'per_person'),
);
const singleSharedTour = sharedTours.length === 1 ? sharedTours[0] : null;

function activeInclusions(tour: Tour): string[] {
  const seen = new Set<string>();
  const inclusions: string[] = [];

  for (const pkg of tour.packages) {
    if (!pkg.isActive) continue;
    for (const item of pkg.includes) {
      if (isPlaceholder(item) || seen.has(item)) continue;
      seen.add(item);
      inclusions.push(item);
    }
  }

  return inclusions;
}

const inclusionsByTour = visibleTours.map(activeInclusions);
const firstInclusions = inclusionsByTour[0] ?? [];
const sharedInclusions =
  inclusionsByTour.length > 0
    ? firstInclusions.filter((item) =>
        inclusionsByTour.every((inclusions) => inclusions.includes(item)),
      )
    : [];

let sharedPickup: string | null = null;
if (visibleTours.length > 0) {
  const names = visibleTours.map(
    (tour) => tour.pickups.find((pickup) => pickup.isActive && !isPlaceholder(pickup.name))?.name,
  );
  if (
    names.every((name): name is string => typeof name === 'string' && name.length > 0) &&
    new Set(names).size === 1
  ) {
    sharedPickup = names[0] ?? null;
  }
}

const maxPrivatePax = Math.max(
  0,
  ...visibleTours
    .filter((tour) => tour.isPrivate)
    .flatMap((tour) =>
      tour.packages
        .filter(
          (pkg) =>
            pkg.isActive && pkg.pricingMode === 'per_group' && typeof pkg.maxPax === 'number',
        )
        .map((pkg) => pkg.maxPax ?? 0),
    ),
);

const whyPoints: string[] = [];
const firstSharedInclusion = sharedInclusions[0];
if (firstSharedInclusion) whyPoints.push(firstSharedInclusion);
if (sharedPickup) whyPoints.push(`Pickup at ${sharedPickup}`);
if (maxPrivatePax > 0) whyPoints.push(`Private vehicle option for up to ${maxPrivatePax} people`);
for (const item of sharedInclusions.slice(1)) {
  if (whyPoints.length >= 4) break;
  whyPoints.push(item);
}

const reviewDateFormatter = new Intl.DateTimeFormat('en-CA', {
  timeZone: 'UTC',
  year: 'numeric',
  month: 'long',
  day: 'numeric',
});

const reviewItems = reviews.map((review) => {
  const date = new Date(`${review.reviewDate}T12:00:00Z`);
  return {
    ...review,
    dateLabel:
      review.reviewDate && !Number.isNaN(date.getTime()) ? reviewDateFormatter.format(date) : '',
  };
});

const heading = 'Niagara Falls Tours from Toronto';
const description =
  'Shared and private Niagara Falls day tours from downtown Toronto, with pickup in the city centre and stops along the Niagara Parkway.';
---

<Site title={`${heading} | ${site.name}`} description={description} site={site} tours={tours}>
  <main class="mx-auto w-full max-w-5xl px-5 pb-16 sm:px-6">
    <section class="pt-10 pb-8 sm:pt-14 sm:pb-10">
      <p class="text-brand text-sm font-semibold tracking-widest uppercase">
        Toronto → Niagara Falls
      </p>
      <h1 class="text-ink mt-2 max-w-3xl text-4xl font-bold tracking-tight text-balance sm:text-5xl">
        {heading}
      </h1>
      <p class="text-ink/80 mt-3 max-w-2xl text-base text-pretty sm:text-lg">{description}</p>
      {from ? (
        <p class="text-ink/70 mt-3 text-base">
          From <span class="text-ink font-semibold">{formatCadHeadline(from.cents)}</span>
          {from.unit === 'person' ? ' per person' : ' per vehicle'}
        </p>
      ) : null}
      <div class="mt-5 flex flex-wrap items-center gap-3">
        <Button href="#tours" variant="primary">
          See tours &amp; dates
        </Button>
        {singleSharedTour ? (
          <Button href={`/tours/${singleSharedTour.slug}/`} variant="secondary">
            Book the {singleSharedTour.title}
          </Button>
        ) : null}
      </div>
    </section>

    <section
      id="tours"
      class="scroll-mt-6 border-t border-ink/10 pt-8 sm:pt-10"
      aria-labelledby="tours-heading"
    >
      <h2 id="tours-heading" class="text-2xl font-bold tracking-tight text-ink sm:text-3xl">
        Tours &amp; dates
      </h2>
      <p class="text-ink/70 mt-2 max-w-2xl text-sm sm:text-base">
        Choose a tour to see live dates, pickups and prices.
      </p>
      <div class="mt-5 grid gap-4 sm:grid-cols-2">
        {visibleTours.map((tour) => (
          <TourCard tour={tour} />
        ))}
      </div>
    </section>

    {whyPoints.length > 0 ? (
      <section class="mt-12" aria-labelledby="why-heading">
        <h2 id="why-heading" class="text-2xl font-bold tracking-tight text-ink">
          Why book with us
        </h2>
        <ul class="mt-4 grid gap-3 sm:grid-cols-2">
          {whyPoints.map((point) => (
            <li class="flex gap-3 rounded-xl border border-ink/10 bg-white p-4 text-sm text-ink/80">
              <span aria-hidden="true" class="text-brand font-semibold">
                ✓
              </span>
              <span>{point}</span>
            </li>
          ))}
        </ul>
      </section>
    ) : null}

    {reviewItems.length > 0 ? (
      <section class="mt-12" aria-labelledby="reviews-heading">
        <h2 id="reviews-heading" class="text-2xl font-bold tracking-tight text-ink">
          What guests say
        </h2>
        <ul class="mt-4 grid gap-4 sm:grid-cols-2 lg:grid-cols-3">
          {reviewItems.map((review) => (
            <li class="rounded-2xl border border-ink/10 bg-white p-5">
              <p class="text-sm font-semibold text-ink">
                <span aria-hidden="true">
                  {'★'.repeat(Math.max(0, Math.min(5, review.rating)))}
                </span>
                <span class="sr-only">{review.rating} out of 5</span>
              </p>
              <blockquote class="mt-2 text-sm text-ink/80">{review.text}</blockquote>
              <p class="mt-3 text-xs text-ink/70">
                {review.location ? `${review.author}, ${review.location}` : review.author}
                {review.dateLabel ? (
                  <>
                    {' · '}
                    <time datetime={review.reviewDate}>{review.dateLabel}</time>
                  </>
                ) : null}
              </p>
            </li>
          ))}
        </ul>
      </section>
    ) : null}

    <FaqList faqs={faqs} />
  </main>
</Site>
