---
import { getCollection } from 'astro:content';

import Button from '../components/Button.astro';
import Base from '../layouts/Base.astro';
import { getTours } from '../lib/db/catalog';
import { formatCadHeadline } from '../lib/format';
import { fromPrice, type FromPrice } from '../lib/pricing';
import '../styles/global.css';

const siteEntry = (await getCollection('site'))[0];
if (!siteEntry) throw new Error('src/content/site.json is missing');
const site = siteEntry.data;

const tours = await getTours();

// The cheapest way in, across every tour the site advertises.
let from: FromPrice | null = null;
for (const tour of tours) {
  const offer = fromPrice(tour);
  if (offer && (from === null || offer.cents < from.cents)) from = offer;
}

const heading = 'Niagara Falls Tours from Toronto';
const description =
  'Shared and private Niagara Falls day tours from downtown Toronto. Pickup at 55 York St, a free Canadian maple syrup tasting and stops along the Niagara Parkway.';
---

<Base title={`${heading} | ${site.name}`} description={description} siteName={site.name}>
  <main class="mx-auto flex min-h-dvh w-full max-w-3xl flex-col justify-center gap-6 px-6 py-24">
    <p class="text-brand text-sm font-semibold tracking-widest uppercase">
      Toronto → Niagara Falls
    </p>
    <h1 class="text-ink text-4xl font-bold tracking-tight text-balance sm:text-5xl">{heading}</h1>
    <p class="text-ink/80 max-w-prose text-lg text-pretty">{description}</p>
    {from ? (
      <p class="text-ink/70 text-base">
        From <span class="text-ink font-semibold">{formatCadHeadline(from.cents)}</span>
        {from.unit === 'person' ? ' per person' : ' per vehicle'}
      </p>
    ) : null}
    <div class="pt-2">
      <Button href="#" variant="primary">
        Book now
      </Button>
    </div>
  </main>
</Base>
