---
export const prerender = true;

import DayTimeline from '../components/DayTimeline.astro';
import FaqList from '../components/FaqList.astro';
import GuideVehicle from '../components/GuideVehicle.astro';
import HeroBanner from '../components/HeroBanner.astro';
import TourCard from '../components/TourCard.astro';
import Site from '../layouts/Site.astro';
import { getTours } from '../lib/db/catalog';
import { getFaqs, getReviews, getSiteSettings } from '../lib/db/content';
import { heroImage } from '../lib/photos';
import { isPlaceholder } from '../lib/placeholder';
import { hasPolicy } from '../lib/policies';
import { tourFacts } from '../lib/tour-facts';

const [site, tours, faqs, allReviews] = await Promise.all([
  getSiteSettings(),
  getTours(),
  getFaqs(null),
  getReviews(),
]);

const visibleTours = tours.filter((tour) => tour.status !== 'hidden');
// The tour the banner sells: the first shared tour, else the first tour.
const mainTour = visibleTours.find((tour) => !tour.isPrivate) ?? visibleTours[0] ?? null;
const privateTour = visibleTours.find((tour) => tour.isPrivate && tour !== mainTour) ?? null;
const mainFacts = mainTour ? tourFacts(mainTour) : null;
const privateFacts = privateTour ? tourFacts(privateTour) : null;
const freeCancellation = hasPolicy(site, 'cancellationPolicy');

const bannerPhoto =
  (mainTour && (heroImage(mainTour.images) ?? mainTour.images[0])) ??
  visibleTours.flatMap((tour) => tour.images)[0] ??
  null;

const heading = isPlaceholder(site.tagline) ? 'Niagara Falls tours from Toronto' : site.tagline;
const bannerFacts = [
  mainFacts?.guests,
  mainFacts?.duration,
  mainFacts?.pickup,
  freeCancellation ? 'Free cancellation' : null,
].filter((fact): fact is string => Boolean(fact));

const trust = [
  mainFacts?.guests ?? null,
  'The price you see includes HST',
  mainTour && !mainTour.isPrivate ? 'Book online, pick your date and seats' : null,
  freeCancellation ? 'Free cancellation' : null,
].filter((item): item is string => Boolean(item));

const comparison =
  visibleTours.length >= 2
    ? visibleTours.map((tour) => ({ tour, facts: tourFacts(tour) }))
    : [];

const reviews = allReviews
  .filter((review) => !isPlaceholder(review.author) && !isPlaceholder(review.text))
  .slice(0, 3);

const reviewDate = new Intl.DateTimeFormat('en-CA', { timeZone: 'UTC', year: 'numeric', month: 'long' });

const description = mainTour
  ? `${mainTour.shortDescription.slice(0, 120)}${mainFacts?.price ? ` From ${mainFacts.price} ${mainFacts.priceUnit}.` : ''}`
  : 'Niagara Falls day tours from Toronto.';
---

<Site title={`${heading} | ${site.name}`} description={description.slice(0, 158)} site={site} tours={tours}>
  <HeroBanner
    photo={bannerPhoto}
    heading={heading}
    lead={mainTour?.shortDescription ?? null}
    facts={bannerFacts}
    price={mainFacts?.price ?? null}
    priceUnit={mainFacts?.priceUnit ?? null}
    cta={mainTour ? { href: `/tours/${mainTour.slug}/#book`, label: 'Check dates' } : null}
    secondary={privateTour && privateFacts?.price
      ? { href: `/tours/${privateTour.slug}/`, label: `Private tour for your group from ${privateFacts.price} per vehicle` }
      : null}
  />

  <main class="mx-auto w-full max-w-5xl px-5 pb-16 sm:px-6">
    <section id="tours" class="scroll-mt-6 pt-12" aria-labelledby="tours-heading">
      <h2 id="tours-heading" class="text-2xl font-bold tracking-tight text-ink sm:text-3xl">Choose your tour</h2>
      <div class="mt-6 grid gap-6 sm:grid-cols-2">
        {visibleTours.map((tour) => <TourCard tour={tour} />)}
      </div>

      {comparison.length > 0 ? (
        <div class="mt-8 overflow-x-auto rounded-2xl border border-ink/10 bg-white">
          <table class="w-full min-w-[32rem] text-left text-sm">
            <caption class="sr-only">Compare the tours</caption>
            <thead>
              <tr class="border-b border-ink/10">
                <th scope="col" class="p-4 font-medium text-ink/70"><span class="sr-only">Detail</span></th>
                {comparison.map(({ tour }) => <th scope="col" class="p-4 font-semibold text-ink">{tour.title}</th>)}
              </tr>
            </thead>
            <tbody>
              <tr class="border-b border-ink/10">
                <th scope="row" class="p-4 font-medium text-ink/70">Price including HST</th>
                {comparison.map(({ facts }) => <td class="p-4 text-ink">{facts.price ? `From ${facts.price} ${facts.priceUnit?.replace(', including HST', '')}` : 'On request'}</td>)}
              </tr>
              <tr class="border-b border-ink/10">
                <th scope="row" class="p-4 font-medium text-ink/70">Group</th>
                {comparison.map(({ tour, facts }) => <td class="p-4 text-ink">{tour.isPrivate ? `Just your group${facts.guests ? `, ${facts.guests.toLowerCase()}` : ''}` : facts.guests ?? 'Small group'}</td>)}
              </tr>
              <tr class="border-b border-ink/10">
                <th scope="row" class="p-4 font-medium text-ink/70">Length</th>
                {comparison.map(({ facts }) => <td class="p-4 text-ink">{facts.duration}</td>)}
              </tr>
              <tr>
                <th scope="row" class="p-4 font-medium text-ink/70">Pickup</th>
                {comparison.map(({ tour, facts }) => <td class="p-4 text-ink">{facts.pickup ?? (tour.isPrivate ? 'Agreed with you' : 'Confirmed when you book')}</td>)}
              </tr>
            </tbody>
          </table>
        </div>
      ) : null}
    </section>

    {trust.length > 0 ? (
      <section class="mt-12 rounded-2xl bg-brand/5 px-5 py-6 sm:px-8" aria-labelledby="trust-heading">
        <h2 id="trust-heading" class="sr-only">Why book with us</h2>
        <ul class="grid gap-4 text-sm font-medium text-ink sm:grid-cols-2 lg:grid-cols-4">
          {trust.map((item) => (
            <li class="flex gap-2"><span aria-hidden="true" class="font-semibold text-brand">✓</span><span>{item}</span></li>
          ))}
        </ul>
      </section>
    ) : null}

    {mainTour ? <DayTimeline stops={mainTour.itinerary} heading="Your day at a glance" id="day-heading" limit={5} /> : null}

    {reviews.length > 0 ? (
      <section class="mt-16" aria-labelledby="reviews-heading">
        <h2 id="reviews-heading" class="text-2xl font-bold tracking-tight text-ink sm:text-3xl">What guests say</h2>
        <ul class="mt-6 grid gap-4 sm:grid-cols-2 lg:grid-cols-3">
          {reviews.map((review) => {
            const date = new Date(`${review.reviewDate}T12:00:00Z`);
            return (
              <li class="flex flex-col rounded-2xl border border-ink/10 bg-white p-5">
                <p class="text-brand">
                  <span aria-hidden="true">{'★'.repeat(Math.max(0, Math.min(5, review.rating)))}</span>
                  <span class="sr-only">{review.rating} out of 5</span>
                </p>
                <blockquote class="mt-2 flex-1 text-sm text-ink/80">{review.text}</blockquote>
                <p class="mt-4 text-sm font-medium text-ink">
                  {review.location ? `${review.author}, ${review.location}` : review.author}
                </p>
                {!Number.isNaN(date.getTime()) ? (
                  <p class="text-xs text-ink/70"><time datetime={review.reviewDate}>{reviewDate.format(date)}</time></p>
                ) : null}
              </li>
            );
          })}
        </ul>
      </section>
    ) : null}

    <GuideVehicle site={site} />

    <div class="mt-4">
      <FaqList faqs={faqs.slice(0, 8)} />
    </div>
  </main>
</Site>
