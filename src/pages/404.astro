---
export const prerender = true;

import Site from '../layouts/Site.astro';
import { getTours } from '../lib/db/catalog';
import { getSiteSettings } from '../lib/db/content';

const [site, tours] = await Promise.all([getSiteSettings(), getTours()]);
const visibleTours = tours.filter((tour) => tour.status !== 'hidden');
---

<Site
  title={`Page not found | ${site.name}`}
  description="This page does not exist. See our Niagara Falls tours from Toronto."
  site={site}
  tours={tours}
  noindex
>
  <main class="mx-auto w-full max-w-3xl px-5 pt-10 pb-16 sm:px-6">
    <h1 class="text-3xl font-bold tracking-tight text-ink sm:text-4xl">Page not found</h1>
    <p class="mt-3 text-base text-ink/80">The page you were looking for has moved or never existed.</p>
    <ul class="mt-6 space-y-2 text-base">
      {visibleTours.map((tour) => (
        <li>
          <a href={`/tours/${tour.slug}/`} class="font-medium text-brand hover:underline focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-brand">
            See the {tour.title}
          </a>
        </li>
      ))}
      <li>
        <a href="/" class="font-medium text-brand hover:underline focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-brand">
          Go to the home page
        </a>
      </li>
    </ul>
  </main>
</Site>
