# Supabase — copy to `.env` and fill in. Every value is optional:
# without them the site builds from fixtures in src/data/fixtures.ts.
PUBLIC_SUPABASE_URL=
PUBLIC_SUPABASE_ANON_KEY=

# Server-only. Never import this into client code or expose it to the browser.
SUPABASE_SERVICE_ROLE_KEY=

# Stripe Checkout. Optional: without these the site takes reservations and asks
# the owner to arrange payment, exactly as before Stripe was set up.
STRIPE_SECRET_KEY=
# From the Stripe dashboard webhook endpoint (checkout.session.completed and
# checkout.session.expired events).
STRIPE_WEBHOOK_SECRET=

# Transactional email through Resend's HTTP API. Optional: without these the
# booking still succeeds and the emails are logged instead of sent.
RESEND_API_KEY=
# A verified Resend sender, e.g. "Toronto Niagara Tours <bookings@torontoniagara.ca>".
EMAIL_FROM=

# Optional: Cloudflare Pages deploy hook, fired (rate-limited) after catalogue saves.
CF_DEPLOY_HOOK_URL=
